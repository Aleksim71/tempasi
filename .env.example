# Copy to .env and fill in. .env is git-ignored - never commit real values.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/tempasi_dev
# Integration tests (name must end in _test):
# DATABASE_URL_TEST=postgres://USER:PASSWORD@127.0.0.1:5432/tempasi_test

# --- Storage --------------------------------------------------------------
# Uploaded template ZIPs and their extracted content. In production this
# points to storage separate from the app server.
TEMPLATE_UPLOAD_DIR=./storage/uploads
AVATAR_UPLOAD_DIR=./storage/avatars
# Separate origin that serves live demos of uploaded templates.
PREVIEW_ORIGIN=http://localhost:4000

# --- Payments -------------------------------------------------------------
# fake (development) | stripe. The fake provider is refused in production.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Mail -----------------------------------------------------------------
# Without SMTP_URL, mails are printed to the console.
SMTP_URL=
MAIL_FROM=Tempasi <no-reply@example.com>

# --- Security / sessions --------------------------------------------------
BCRYPT_ROUNDS=12
# SESSION_TTL_SHORT_SECONDS=
# SESSION_TTL_REMEMBER_SECONDS=
# RESET_TOKEN_TTL_SECONDS=
# EMAIL_VERIFICATION_TTL_SECONDS=

# --- Development only (ignored or refused in production) ------------------
# TEMPASI_SKIP_AUTH=1
