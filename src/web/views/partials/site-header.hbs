{{!-- src/web/views/partials/site-header.hbs --}}
<header class="site-header" role="banner">
  <div class="site-header__inner l-container">

    <a class="site-header__brand" href="/" aria-label="Tempasi home">
      <img
        class="site-header__mark"
        src="/img/brand/tempasi-mark-white-32.png"
        srcset="
          /img/brand/tempasi-mark-white-32.png 1x,
          /img/brand/tempasi-mark-white-64.png 2x
        "
        width="32"
        height="32"
        alt="Tempasi"
        loading="eager"
        decoding="async"
      />
      <span class="site-header__word" aria-hidden="true">TEMPASI</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <a href="/templates" class="nav-link {{#if (eq activePage 'templates')}}is-active{{/if}}">
        Шаблоны
      </a>
      <a href="/about" class="nav-link {{#if (eq activePage 'about')}}is-active{{/if}}">
        About
      </a>
      <a href="/contact" class="nav-link {{#if (eq activePage 'contact')}}is-active{{/if}}">
        Contact
      </a>
      <a href="/community" class="nav-link {{#if (eq activePage 'community')}}is-active{{/if}}">
        Community
      </a>
      <a href="/discounts" class="nav-link {{#if (eq activePage 'discounts')}}is-active{{/if}}">
        Скидки
      </a>
      <a href="/profile" class="nav-link {{#if (eq activePage 'profile')}}is-active{{/if}}">
        Профиль
      </a>
    </nav>

    <div class="site-header__actions">
      <a class="c-btn c-btn--sm site-header__icon-btn" href="/profile" aria-label="Profile">
        <svg class="tp-icon tp-icon--lg" aria-hidden="true">
          <use href="/icons/tempasi-sprite.svg?v=dev#tp-header-profile"></use>
        </svg>
      </a>

      <a class="c-btn c-btn--sm site-header__icon-btn" href="/cart" aria-label="Cart">
        <svg class="tp-icon tp-icon--lg" aria-hidden="true">
          <use href="/icons/tempasi-sprite.svg?v=dev#tp-header-cart"></use>
        </svg>
      </a>
    </div>

  </div>
</header>


</header>
