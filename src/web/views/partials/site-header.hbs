{{!-- src/web/views/partials/site-header.hbs --}}
<header class="site-header" role="banner" data-brand="{{brand}}">
  <div class="site-header__inner l-container">
    {{!-- Logo --}}
    <a class="site-header__brand" href="/templates" aria-label="Tempasi home">
      <img
        class="site-header__logo"
        src="/img/brand/logo_tempasi_licht.png"
        alt="Tempasi"
        width="28"
        height="28"
        loading="eager"
        decoding="async"
      />
      <span class="site-header__wordmark" aria-hidden="true">TEMPASI</span>
    </a>

    {{!-- Modes --}}
    <nav class="site-header__modes" aria-label="Modes">
      <a href="/templates" class="site-header__mode {{#if (eq activePage 'templates')}}is-active{{/if}}">
        Templates
      </a>
      <a href="/profile" class="site-header__mode {{#if (eq activePage 'profile')}}is-active{{/if}}">
        Cabinet
      </a>
    </nav>

    {{!-- Actions --}}
    <div class="site-header__actions" aria-label="Actions">
      <a class="site-header__action" href="/templates#search" aria-label="Search" title="Search">
        <svg class="tp-ico" width="18" height="18" aria-hidden="true">
          <use href="#tp-action-search"></use>
        </svg>
      </a>

      <a class="site-header__action" href="/cart" aria-label="Cart" title="Cart">
        <svg class="tp-ico" width="18" height="18" aria-hidden="true">
          <use href="#tp-action-cart"></use>
        </svg>
      </a>

      <form class="site-header__logout" action="/api/auth/logout" method="post">
        <button class="site-header__action" type="submit" aria-label="Logout" title="Logout">
          <svg class="tp-ico" width="18" height="18" aria-hidden="true">
            <use href="#tp-action-logout"></use>
          </svg>
        </button>
      </form>
    </div>
  </div>
</header>
