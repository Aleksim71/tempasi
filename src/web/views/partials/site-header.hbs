<header class="site-header">
  <div class="l-container">
    <div class="site-header__inner">

      <!-- LEFT -->
      <div class="site-header__left">
        <a href="/templates" class="site-header__brand" aria-label="Tempasi home">
          <img
            class="site-header__brand-logo"
            src="/img/logo-tempasi.png"
            alt="Tempasi"
            width="22"
            height="22"
            loading="eager"
            decoding="async"
          />
          <span class="site-header__title">TEMPASI</span>
        </a>
      </div>

      <!-- CENTER -->
      <nav class="site-header__nav" aria-label="Main navigation">
        <a href="/templates" class="nav-link{{#if (eq activePage 'templates')}} nav-link--active{{/if}}">Templates</a>

        {{#if isAuthed}}
          <a href="/community" class="nav-link{{#if (eq activePage 'community')}} nav-link--active{{/if}}">Community</a>
          <a href="/cabinet" class="nav-link{{#if (eq activePage 'cabinet')}} nav-link--active{{/if}}">Cabinet</a>
        {{/if}}
      </nav>

      <!-- RIGHT -->
      <div class="site-header__actions">

        {{#if isAuthed}}          <!-- cart -->
          <a href="/cart" class="header-icon" aria-label="Cart">
            {{> icon-cart}}
            {{#if cartCount}}
              <span class="header-cart-count">{{cartCount}}</span>
            {{/if}}
          </a>

          <!-- logout -->
          <form method="post" action="/api/auth/logout" class="header-icon">
            <button type="submit" aria-label="Logout">
              {{> icon-logout}}
            </button>
          </form>

        {{else}}

          <!-- login -->
          <a href="/login" class="header-icon" aria-label="Login">
            {{> icon-login}}
          </a>

          <!-- placeholder (keeps width) -->
          <span class="header-icon header-icon--placeholder" aria-hidden="true"></span>

        {{/if}}

      </div>

    </div>
  </div>
</header>
