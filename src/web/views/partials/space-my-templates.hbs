<section class="cabinet-workspace">

  <nav class="mt-tabs" aria-label="My Templates">
    <a class="mt-tab {{#if isMyTemplatesAdd}}is-active{{/if}}" href="/cabinet/my-templates/add">
      Add
    </a>
    <a class="mt-tab {{#if isMyTemplatesList}}is-active{{/if}} tp-control tp-tab tp-tab--main" href="/cabinet/my-templates" data-tempasi-main-tab="list">
      List
    </a>
    <a class="mt-tab {{#if isMyTemplatesAnalytics}}is-active{{/if}} tp-control tp-tab tp-tab--main" href="/cabinet/my-templates/analytics" data-tempasi-main-tab="analytics">
      Analytics
    </a>
  </nav>

  {{#if workspaceError}}
    <div class="badge badge--danger">
      Error: {{workspaceError.message}}
    </div>
  {{/if}}

  {{!-- =========================
        LIST
  ========================== --}}
  {{#if isMyTemplatesList}}

    {{#if workspaceData.items.length}}

      <div class="seller-templates">

        {{#each workspaceData.items}}
          <div class="seller-card">

            <div class="seller-card__preview">
              <img
                src="/t/{{slug}}/preview/preview.png"
                alt="{{title}}"
                onerror="this.onerror=null;this.src='/img/preview-placeholder.svg';"
              >
            </div>

            <div class="seller-card__content">
              <h3 class="seller-card__title">{{title}}</h3>

              <div class="seller-card__meta">
                <div><strong>Article:</strong> TMP-{{id}}<br>
                  <strong>Slug:</strong> {{slug}}</div>

                {{#if price_buy_eur}}
                  <div><strong>Buy:</strong> €{{price_buy_eur}}</div>
                {{/if}}

                {{#if price_rent_eur}}
                  <div><strong>Rent:</strong> €{{price_rent_eur}}</div>
                {{/if}}

                {{#if is_admin_blocked}}
                  <div><strong>Status:</strong> <span class="badge badge--blocked">BLOCKED BY ADMIN</span></div>
                {{/if}}

                {{#if is_sold}}
                  <div><strong>Status:</strong> <span class="badge badge--sold">SOLD</span></div>
                  {{#if sold_at_str}}
                    <div><strong>Sold at:</strong> {{sold_at_str}}</div>
                  {{/if}}
                {{/if}}
              </div>

              <div class="seller-card__actions">

                <a href="/cabinet/my-templates/{{id}}/edit" class="button">
                  Edit
                </a>

                {{#if is_published}}
                  <form method="post" action="/cabinet/my-templates/{{id}}/status" style="display:inline;">
                    <input type="hidden" name="status" value="draft" />
                    <button type="submit" class="button">
                      Unpublish
                    </button>
                  </form>
                {{else}}
                  {{#if is_admin_blocked}}
                    <span
                      class="button"
                      aria-disabled="true"
                      style="opacity:0.5; cursor:not-allowed;"
                      title="This template was blocked by an admin and cannot be republished right now."
                    >
                      Publish (blocked)
                    </span>
                  {{else}}
                    <form method="post" action="/cabinet/my-templates/{{id}}/status" style="display:inline;">
                      <input type="hidden" name="status" value="published" />
                      <button type="submit" class="button button--primary">
                        Publish
                      </button>
                    </form>
                  {{/if}}
                {{/if}}

                <form method="post" action="/cabinet/my-templates/{{id}}/delete" style="display:inline;">
                  <button type="submit" class="button button--danger">
                    Delete
                  </button>
                </form>

              </div>

            </div>

          </div>
        {{/each}}

      </div>

    {{else}}
      <div class="empty-state">
        <p>You don’t have any templates yet.</p>
        <a href="/cabinet/my-templates/add" class="button button--primary">
          Add your first template
        </a>
      </div>
    {{/if}}

  {{/if}}

  {{!-- =========================
        ADD
  ========================== --}}
  {{#if isMyTemplatesAdd}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Add Template</div>

      <form class="form" method="post" action="/cabinet/my-templates/add" enctype="multipart/form-data">
        <div class="form__row">
          <label class="form__label" for="status">Status *</label>
          <div class="form__radios">
            <label class="radio">
              <input type="radio" name="status" value="draft" {{#if formIsDraft}}checked{{/if}}>
              Draft
            </label>
            <label class="radio">
              <input type="radio" name="status" value="published" {{#if formIsPublished}}checked{{/if}}>
              Published
            </label>
          </div>
          <div class="form__hint">Draft is visible only to you. Published is visible in the public catalog.</div>
        </div>

        <div class="form__row">
          <label class="form__label" for="title">Title *</label>
          <input class="input" id="title" name="title" type="text" value="{{form.title}}" autocomplete="off" />
          {{#if formErrors.title}}
            <div class="form__error">{{formErrors.title}}</div>
          {{/if}}
          {{#if formErrors.slug}}
            <div class="form__error">{{formErrors.slug}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="shortDescription">Short description</label>
          <textarea class="textarea" id="shortDescription" name="shortDescription" rows="3">{{form.shortDescription}}</textarea>
        </div>

        <div class="form__grid">
          <div class="form__row">
            <label class="form__label" for="category">Category *</label>
            <select class="input" id="category" name="category" required>
              {{#each categoryOptions}}
                <option value="{{this.slug}}" {{#if (eq this.slug ../form.category)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="form__row">
            <label class="form__label" for="tags">Tags</label>
            <input class="input" id="tags" name="tags" type="text" value="{{form.tags}}" placeholder="hotel, villa, luxury, booking" autocomplete="off" />
            <div class="form__hint">Use comma-separated tags. Example: hotel, villa, luxury.</div>
          </div>
        </div>


        
        <div class="form__grid form__grid--prices">
          <div class="form__row">
            <label class="form__label" for="priceBuy">Buy price (EUR) *</label>
            <input class="input" id="editPriceBuy" name="priceBuy" type="text" value="{{form.priceBuy}}" inputmode="decimal" required />
            {{#if formErrors.priceBuy}}
              <div class="form__error">{{formErrors.priceBuy}}</div>
            {{/if}}
          </div>

          <div class="form__row">
            <label class="form__label" for="priceRent">Rent price (EUR) *</label>
            <input class="input" id="priceRent" name="priceRent" type="text" value="{{form.priceRent}}" inputmode="decimal" required />
            {{#if formErrors.priceRent}}
              <div class="form__error">{{formErrors.priceRent}}</div>
            {{/if}}
          </div>
        </div>

        <div class="form__row">
          <label class="form__label" for="templateZip">Upload ZIP *</label>
          <input class="input" id="templateZip" name="templateZip" type="file" accept=".zip" />
          <div class="form__hint">
            ZIP requirements (MVP): must include <code>preview/preview.png</code> (or <code>preview.png</code>) and entry page
            <code>index.html</code> (or <code>src/index.html</code>).
          </div>
          {{#if formErrors.templateZip}}
            <div class="form__error">{{formErrors.templateZip}}</div>
          {{/if}}
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit">Add</button>
          <a class="button" href="/cabinet/my-templates">Cancel</a>
        </div>
      </form>
    </div>
  {{/if}}

  {{!-- =========================
        EDIT
  ========================== --}}
  {{#if isMyTemplatesEdit}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Edit Template</div>

      <form class="form" method="post" action="" enctype="multipart/form-data">
        <div class="form__row">
          <label class="form__label" for="status">Status *</label>
          <div class="form__radios">
            <label class="radio">
              <input type="radio" name="status" value="draft" {{#if formIsDraft}}checked{{/if}}>
              Draft
            </label>
            <label class="radio">
              <input type="radio" name="status" value="published" {{#if formIsPublished}}checked{{/if}}>
              Published
            </label>
          </div>
          <div class="form__hint">Draft is visible only to you. Published is visible in the public catalog.</div>
        </div>
        <div class="form__row">
          <label class="form__label" for="title">Title *</label>
          <input class="input" id="title" name="title" type="text" value="{{form.title}}" autocomplete="off" />
          {{#if formErrors.title}}
            <div class="form__error">{{formErrors.title}}</div>
          {{/if}}
          {{#if formErrors.slug}}
            <div class="form__error">{{formErrors.slug}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="shortDescription">Short description</label>
          <textarea class="textarea" id="shortDescription" name="shortDescription" rows="3">{{form.shortDescription}}</textarea>
        </div>

        <div class="form__grid">
          <div class="form__row">
            <label class="form__label" for="editCategory">Category *</label>
            <select class="input" id="editCategory" name="category" required>
              {{#each categoryOptions}}
                <option value="{{this.slug}}" {{#if (eq this.slug ../form.category)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="form__row">
            <label class="form__label" for="editTags">Tags</label>
            <input class="input" id="editTags" name="tags" type="text" value="{{form.tags}}" placeholder="hotel, villa, luxury, booking" autocomplete="off" />
            <div class="form__hint">Use comma-separated tags. Example: hotel, villa, luxury.</div>
          </div>
        </div>


        
<div class="form__grid form__grid--prices">
          <div class="form__row">
            <label class="form__label" for="editPriceBuy">Buy price (EUR) *</label>
            <input class="input" id="priceBuy" name="priceBuy" type="text" value="{{form.priceBuy}}" inputmode="decimal" required />
            {{#if formErrors.priceBuy}}
              <div class="form__error">{{formErrors.priceBuy}}</div>
            {{/if}}
          </div>

          <div class="form__row">
            <label class="form__label" for="editPriceRent">Rent price (EUR) *</label>
            <input class="input" id="editPriceRent" name="priceRent" type="text" value="{{form.priceRent}}" inputmode="decimal" required />
            {{#if formErrors.priceRent}}
              <div class="form__error">{{formErrors.priceRent}}</div>
            {{/if}}
          </div>
        </div>

        <div class="form__row">
          <div class="form__hint"><strong>Current ZIP:</strong> {{#if form.currentZipName}}{{form.currentZipName}}{{else}}No ZIP uploaded{{/if}}</div>
        </div>

        <div class="form__row">
          <label class="form__label" for="templateZip">Replace ZIP (optional)</label>
          <input class="input" id="templateZip" name="templateZip" type="file" accept=".zip" />
          <div class="form__hint">
            ZIP requirements (MVP): must include <code>preview/preview.png</code> (or <code>preview.png</code>) and entry page
            <code>index.html</code> (or <code>src/index.html</code>).
          </div>
          {{#if formErrors.templateZip}}
            <div class="form__error">{{formErrors.templateZip}}</div>
          {{/if}}
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit">Update</button>
          <a class="button" href="/cabinet/my-templates">Back to List</a>
        </div>
      </form>
    </div>
  {{/if}}

  {{!-- =========================
        ANALYTICS
  ========================== --}}
  {{#if isMyTemplatesAnalytics}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Analytics</div>

      {{!-- MVP view switch: 3 subtabs --}}
      <nav class="mt-view-switch" aria-label="Analytics view">
        <a
          class="mt-view-btn {{#if (eq workspaceData.analytics.tab "overview")}}is-active{{/if}}"
          href="/cabinet/my-templates/analytics?tab=overview"
          {{#if (eq workspaceData.analytics.tab "overview")}}aria-current="page"{{/if}}
        >
          Overview
        </a>

        <a
          class="mt-view-btn {{#if (eq workspaceData.analytics.tab "table")}}is-active{{/if}}"
          href="/cabinet/my-templates/analytics?tab=table"
          {{#if (eq workspaceData.analytics.tab "table")}}aria-current="page"{{/if}}
        >
          Table
        </a>

        <a
          class="mt-view-btn {{#if (eq workspaceData.analytics.tab "advanced")}}is-active{{/if}}"
          href="/cabinet/my-templates/analytics?tab=advanced"
          {{#if (eq workspaceData.analytics.tab "advanced")}}aria-current="page"{{/if}}
        >
          Advanced
        </a>
      </nav>

      {{!-- OVERVIEW TAB: KPIs + chart only --}}
      {{#if (eq workspaceData.analytics.tab "overview")}}
        <div data-analytics-tab="overview">

          <div class="mt-kpis">
            <div class="mt-kpi">
              <div class="mt-kpi__label">Active templates</div>
              <div class="mt-kpi__value">{{workspaceData.analytics.kpis.activeTemplates}}</div>
            </div>
            <div class="mt-kpi">
              <div class="mt-kpi__label">Sold templates</div>
              <div class="mt-kpi__value">{{workspaceData.analytics.kpis.soldTemplates}}</div>
            </div>
            <div class="mt-kpi">
              <div class="mt-kpi__label">Rent revenue</div>
              <div class="mt-kpi__value">{{workspaceData.analytics.kpis.rentRevenueEur}}</div>
            </div>
            <div class="mt-kpi">
              <div class="mt-kpi__label">Total revenue</div>
              <div class="mt-kpi__value">{{workspaceData.analytics.kpis.totalRevenueEur}}</div>
            </div>
          </div>

          <div class="mt-chart">
            <div class="mt-chart__title">Revenue (last 30 days)</div>
            <canvas id="rev30dChart" width="720" height="220" aria-label="Revenue last 30 days"></canvas>
            <script type="application/json" id="rev30dData">{{{workspaceData.analytics.revenueSeries30dJson}}}</script>
          </div>

          <script>
            (function () {
              const dataEl = document.getElementById('rev30dData');
              const canvas = document.getElementById('rev30dChart');
              if (!dataEl || !canvas) return;

              let series = [];
              try {
                series = JSON.parse(dataEl.textContent || '[]');
              } catch (e) {
                return;
              }

              const ctx = canvas.getContext('2d');
              if (!ctx) return;

              const w = canvas.width;
              const h = canvas.height;
              const padding = 24;

              ctx.clearRect(0, 0, w, h);

              const values = series.map((d) => Number(d.revenueCents || 0));
              const max = values.length ? Math.max(...values) : 0;

              // Axes baseline
              ctx.strokeStyle = 'rgba(255,255,255,0.12)';
              ctx.beginPath();
              ctx.moveTo(padding, h - padding);
              ctx.lineTo(w - padding, h - padding);
              ctx.stroke();

              if (max === 0) {
                ctx.fillStyle = 'rgba(255,255,255,0.6)';
                ctx.font = '12px system-ui, sans-serif';
                ctx.fillText('No revenue in last 30 days', padding, padding);
                return;
              }

              const xStep = (w - padding * 2) / (series.length - 1 || 1);
              const yScale = (h - padding * 2) / max;

              ctx.strokeStyle = 'rgba(120, 200, 255, 0.9)';
              ctx.lineWidth = 2;
              ctx.beginPath();

              series.forEach((d, i) => {
                const x = padding + i * xStep;
                const y = h - padding - Number(d.revenueCents || 0) * yScale;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
              });
              ctx.stroke();

              ctx.fillStyle = 'rgba(120, 200, 255, 0.9)';
              series.forEach((d, i) => {
                const x = padding + i * xStep;
                const y = h - padding - Number(d.revenueCents || 0) * yScale;
                ctx.beginPath();
                ctx.arc(x, y, 2, 0, Math.PI * 2);
                ctx.fill();
              });

              // X labels (every ~6 points)
              ctx.fillStyle = 'rgba(255,255,255,0.6)';
              ctx.font = '10px system-ui, sans-serif';
              const step = Math.max(1, Math.floor(series.length / 5));
              series.forEach((d, i) => {
                if (i % step !== 0 && i !== series.length - 1) return;
                const x = padding + i * xStep;
                const label = d.label || '';
                ctx.fillText(label, x - 8, h - 8);
              });
            })();
          </script>

        </div>
      {{/if}}

      {{!-- TABLE TAB --}}
      {{#if (eq workspaceData.analytics.tab "table")}}
        <div data-analytics-tab="table">
          <div class="mt-analytics-wrap">
            <table class="mt-analytics">
              <thead>
                <tr>
                  {{#each workspaceData.analytics.columns}}
                    <th class="{{#if isActive}}is-active{{/if}}">
                      {{#if sortable}}
                        <a
                          href="{{href}}"
                          class="mt-analytics__sortLink {{#if isActive}}is-active{{/if}}"
                        >
                          {{label}}{{#if arrow}}<span class="mt-analytics__arrow">{{arrow}}</span>{{/if}}
                        </a>
                      {{else}}
                        {{label}}
                      {{/if}}
                    </th>
                  {{/each}}
                </tr>
              </thead>
              <tbody>
                {{#if workspaceData.analytics.items.length}}
                  {{#each workspaceData.analytics.items}}
                    <tr>
                      <td>
                        <div class="mt-analytics__templateTitle">{{title}}</div>
                        <div class="mt-analytics__templateSlug">{{slug}}</div>
                      </td>
                      <td>{{#if created_at_str}}{{created_at_str}}{{else}}—{{/if}}</td>
                      <td>{{#if deleted_at_str}}{{deleted_at_str}}{{else}}—{{/if}}</td>
                      <td>{{#if first_order_at_str}}{{first_order_at_str}}{{else}}—{{/if}}</td>
                      <td>{{#if sold_at_str}}{{sold_at_str}}{{else}}—{{/if}}</td>
                      <td>{{rent_count}}</td>
                      <td>€{{rent_revenue_eur}}</td>
                      <td>€{{buy_revenue_eur}}</td>
                      <td>€{{total_revenue_eur}}</td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr class="mt-analytics__emptyRow">
                    <td colspan="9" class="mt-analytics__empty">
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>
      {{/if}}

      {{!-- ADVANCED TAB (MVP placeholder) --}}
      {{#if (eq workspaceData.analytics.tab "advanced")}}
        <div data-analytics-tab="advanced">
          <section class="mt-advanced-placeholder">
            <div class="mt-advanced-placeholder__eyebrow">MVP</div>
            <h3 class="mt-advanced-placeholder__title">Advanced analytics</h3>
            <p class="mt-advanced-placeholder__text">
              This section is reserved for deeper seller insights. For MVP, the tab is active and ready for the next iteration.
            </p>

            <ul class="mt-advanced-placeholder__list">
              <li>Conversion from rent to buy</li>
              <li>Best-performing templates over time</li>
              <li>Revenue trends by period</li>
              <li>Archived vs active template performance</li>
            </ul>
          </section>
        </div>
      {{/if}}

    </div>
  {{/if}}

  <script>
    (() => {
      // TEMPASI_FORM_ERRORS_MODAL (2026-08-12)
      // Server-rendered form errors (the top "Error: ..." banner and
      // the small red text under individual fields) are easy to miss
      // — reads whatever's already in the DOM and re-shows it
      // prominently via the shared modal shell (core.js), instead of
      // duplicating the error data/logic in a second place. Works for
      // both the Add and Edit forms, since both use the same
      // .badge--danger / .form__error markup.
      const banner = document.querySelector('.cabinet-workspace > .badge--danger');
      const fieldErrors = Array.from(document.querySelectorAll('.form__error'))
        .map((el) => el.textContent.trim())
        .filter(Boolean);

      const messages = [];
      if (banner && banner.textContent.trim()) messages.push(banner.textContent.trim());
      messages.push(...fieldErrors);

      if (!messages.length) return;

      const html =
        '<div style="padding:4px 4px 0;">' +
        '<h3 style="margin:0 0 12px;font-size:18px;color:var(--c-danger, #fb7185);">' +
        'Error!' +
        '</h3>' +
        '<ul style="margin:0 0 20px;padding-left:20px;display:grid;gap:8px;">' +
        messages.map((m) => '<li>' + m.replace(/</g, '&lt;') + '</li>').join('') +
        '</ul>' +
        '<button type="button" id="tps-form-error-close" style="width:100%;padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.2);background:transparent;color:#fff;cursor:pointer;">Close</button>' +
        '</div>';

      const show = () => {
        if (window.TempasiModal && typeof window.TempasiModal.show === 'function') {
          window.TempasiModal.show(html);
          const closeBtn = document.getElementById('tps-form-error-close');
          if (closeBtn) closeBtn.addEventListener('click', () => window.TempasiModal.hide());
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', show);
      } else {
        show();
      }
    })();
  </script>

</section>

