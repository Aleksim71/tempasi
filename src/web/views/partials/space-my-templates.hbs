<section class="cabinet-workspace">

  <nav class="mt-tabs" aria-label="My Templates">
    <a class="mt-tab {{#if isMyTemplatesAdd}}is-active{{/if}}" href="/cabinet/my-templates/add">
      Add
    </a>
    <a class="mt-tab {{#if isMyTemplatesList}}is-active{{/if}}" href="/cabinet/my-templates">
      List
    </a>
    <a class="mt-tab {{#if isMyTemplatesAnalytics}}is-active{{/if}}" href="/cabinet/my-templates/analytics">
      Analytics
    </a>
  </nav>

  {{#if workspaceError}}
    <div class="badge badge--danger">
      Error: {{workspaceError.message}}
    </div>
  {{/if}}

  {{!-- =========================
        LIST
  ========================== --}}
  {{#if isMyTemplatesList}}

    {{#if workspaceData.items.length}}

      <div class="seller-templates">

        {{#each workspaceData.items}}
          <div class="seller-card">

            <div class="seller-card__preview">
              <img
                src="/uploads/previews/{{id}}.png?t={{updated_ts}}"
                alt="{{title}}"
                onerror="this.onerror=null;this.src='/img/preview-placeholder.svg';"
              >
            </div>

            <div class="seller-card__content">
              <h3 class="seller-card__title">{{title}}</h3>

              <div class="seller-card__meta">
                <div><strong>Slug:</strong> {{slug}}</div>

                {{#if price_buy_eur}}
                  <div><strong>Buy:</strong> €{{price_buy_eur}}</div>
                {{/if}}

                {{#if price_rent_eur}}
                  <div><strong>Rent:</strong> €{{price_rent_eur}}</div>
                {{/if}}
              </div>

              <div class="seller-card__actions">

                <a href="/cabinet/my-templates/{{id}}/edit" class="button">
                  Edit
                </a>

                {{#if is_published}}
                  <form method="post" action="/cabinet/my-templates/{{id}}/status" style="display:inline;">
                    <input type="hidden" name="status" value="draft" />
                    <button type="submit" class="button">
                      Unpublish
                    </button>
                  </form>
                {{else}}
                  <form method="post" action="/cabinet/my-templates/{{id}}/status" style="display:inline;">
                    <input type="hidden" name="status" value="published" />
                    <button type="submit" class="button button--primary">
                      Publish
                    </button>
                  </form>
                {{/if}}

                <form method="post" action="/cabinet/my-templates/{{id}}/delete" style="display:inline;">
                  <button type="submit" class="button button--danger">
                    Delete
                  </button>
                </form>

              </div>

            </div>

          </div>
        {{/each}}

      </div>

    {{else}}
      <div class="empty-state">
        <p>You don’t have any templates yet.</p>
        <a href="/cabinet/my-templates/add" class="button button--primary">
          Add your first template
        </a>
      </div>
    {{/if}}

  {{/if}}

  {{!-- =========================
        ADD
  ========================== --}}
  {{#if isMyTemplatesAdd}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Add Template</div>

      <form class="form" method="post" action="/cabinet/my-templates/add" enctype="multipart/form-data">
        <div class="form__row">
          <label class="form__label" for="status">Status *</label>
          <div class="form__radios">
            <label class="radio">
              <input type="radio" name="status" value="draft" {{#if formIsDraft}}checked{{/if}}>
              Draft
            </label>
            <label class="radio">
              <input type="radio" name="status" value="published" {{#if formIsPublished}}checked{{/if}}>
              Published
            </label>
          </div>
          <div class="form__hint">Draft is visible only to you. Published is visible in the public catalog.</div>
        </div>

        <div class="form__row">
          <label class="form__label" for="title">Title *</label>
          <input class="input" id="title" name="title" type="text" value="{{form.title}}" autocomplete="off" />
          {{#if formErrors.title}}
            <div class="form__error">{{formErrors.title}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="slug">Slug *</label>
          <input class="input" id="slug" name="slug" type="text" value="{{form.slug}}" autocomplete="off" />
          <div class="form__hint">letters/numbers/dashes, e.g. <code>dentist-landing</code></div>
          {{#if formErrors.slug}}
            <div class="form__error">{{formErrors.slug}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="shortDescription">Short description</label>
          <textarea class="textarea" id="shortDescription" name="shortDescription" rows="3">{{form.shortDescription}}</textarea>
        </div>

        <div class="form__grid">
          <div class="form__row">
            <label class="form__label" for="priceBuy">Buy price (EUR)</label>
            <input class="input" id="priceBuy" name="priceBuy" type="text" value="{{form.priceBuy}}" inputmode="decimal" />
            {{#if formErrors.priceBuy}}
              <div class="form__error">{{formErrors.priceBuy}}</div>
            {{/if}}
          </div>

          <div class="form__row">
            <label class="form__label" for="priceRent">Rent price (EUR)</label>
            <input class="input" id="priceRent" name="priceRent" type="text" value="{{form.priceRent}}" inputmode="decimal" />
            {{#if formErrors.priceRent}}
              <div class="form__error">{{formErrors.priceRent}}</div>
            {{/if}}
          </div>
        </div>

        <div class="form__row">
          <label class="form__label" for="templateZip">Upload ZIP *</label>
          <input class="input" id="templateZip" name="templateZip" type="file" accept=".zip" />
          <div class="form__hint">
            ZIP requirements (MVP): must include <code>preview/preview.png</code> (or <code>preview.png</code>) and entry page
            <code>index.html</code> (or <code>src/index.html</code>).
          </div>
          {{#if formErrors.templateZip}}
            <div class="form__error">{{formErrors.templateZip}}</div>
          {{/if}}
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit">Add</button>
          <a class="button" href="/cabinet/my-templates">Cancel</a>
        </div>
      </form>
    </div>
  {{/if}}

  {{!-- =========================
        EDIT
  ========================== --}}
  {{#if isMyTemplatesEdit}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Edit Template</div>

      <form class="form" method="post" action="/cabinet/my-templates/{{form.id}}/edit" enctype="multipart/form-data">
        <div class="form__row">
          <label class="form__label" for="title">Title *</label>
          <input class="input" id="title" name="title" type="text" value="{{form.title}}" autocomplete="off" />
          {{#if formErrors.title}}
            <div class="form__error">{{formErrors.title}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="slug">Slug *</label>
          <input class="input" id="slug" name="slug" type="text" value="{{form.slug}}" autocomplete="off" />
          <div class="form__hint">letters/numbers/dashes, e.g. <code>dentist-landing</code></div>
          {{#if formErrors.slug}}
            <div class="form__error">{{formErrors.slug}}</div>
          {{/if}}
        </div>

        <div class="form__row">
          <label class="form__label" for="shortDescription">Short description</label>
          <textarea class="textarea" id="shortDescription" name="shortDescription" rows="3">{{form.shortDescription}}</textarea>
        </div>

        <div class="form__grid">
          <div class="form__row">
            <label class="form__label" for="priceBuy">Buy price (EUR)</label>
            <input class="input" id="priceBuy" name="priceBuy" type="text" value="{{form.priceBuy}}" inputmode="decimal" />
            {{#if formErrors.priceBuy}}
              <div class="form__error">{{formErrors.priceBuy}}</div>
            {{/if}}
          </div>

          <div class="form__row">
            <label class="form__label" for="priceRent">Rent price (EUR)</label>
            <input class="input" id="priceRent" name="priceRent" type="text" value="{{form.priceRent}}" inputmode="decimal" />
            {{#if formErrors.priceRent}}
              <div class="form__error">{{formErrors.priceRent}}</div>
            {{/if}}
          </div>
        </div>

        <div class="form__row">
          <div class="form__hint"><strong>Current ZIP:</strong> {{form.currentZipName}}</div>
        </div>

        <div class="form__row">
          <label class="form__label" for="templateZip">Replace ZIP (optional)</label>
          <input class="input" id="templateZip" name="templateZip" type="file" accept=".zip" />
          <div class="form__hint">
            ZIP requirements (MVP): must include <code>preview/preview.png</code> (or <code>preview.png</code>) and entry page
            <code>index.html</code> (or <code>src/index.html</code>).
          </div>
          {{#if formErrors.templateZip}}
            <div class="form__error">{{formErrors.templateZip}}</div>
          {{/if}}
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit">Update</button>
          <a class="button" href="/cabinet/my-templates">Back to List</a>
        </div>
      </form>
    </div>
  {{/if}}

  {{!-- =========================
        ANALYTICS
  ========================== --}}
  {{#if isMyTemplatesAnalytics}}
    <div class="cabinet__panel">
      <div class="cabinet__panelTitle">Analytics</div>

      {{#if workspaceData.analytics.items.length}}
        <table class="mt-analytics">
          <thead>
            <tr>
              <th>Template</th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=created_at&dir={{#if (and (eq workspaceData.analytics.sort 'created_at') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'created_at')}}is-active{{/if}}"
                >
                  Created
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=deleted_at&dir={{#if (and (eq workspaceData.analytics.sort 'deleted_at') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'deleted_at')}}is-active{{/if}}"
                >
                  Archived
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=first_order_at&dir={{#if (and (eq workspaceData.analytics.sort 'first_order_at') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'first_order_at')}}is-active{{/if}}"
                >
                  First order
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=last_order_at&dir={{#if (and (eq workspaceData.analytics.sort 'last_order_at') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'last_order_at')}}is-active{{/if}}"
                >
                  Last order
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=rent_count&dir={{#if (and (eq workspaceData.analytics.sort 'rent_count') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'rent_count')}}is-active{{/if}}"
                >
                  Rent count
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=rent_revenue&dir={{#if (and (eq workspaceData.analytics.sort 'rent_revenue') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'rent_revenue')}}is-active{{/if}}"
                >
                  Rent revenue
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=buy_revenue&dir={{#if (and (eq workspaceData.analytics.sort 'buy_revenue') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'buy_revenue')}}is-active{{/if}}"
                >
                  Buy revenue
                </a>
              </th>
              <th>
                <a
                  href="/cabinet/my-templates/analytics?sort=total_revenue&dir={{#if (and (eq workspaceData.analytics.sort 'total_revenue') (eq workspaceData.analytics.dir 'desc'))}}asc{{else}}desc{{/if}}"
                  class="mt-analytics__sortLink {{#if (eq workspaceData.analytics.sort 'total_revenue')}}is-active{{/if}}"
                >
                  Total revenue
                </a>
              </th>
            </tr>
          </thead>
          <tbody>
            {{#each workspaceData.analytics.items}}
              <tr>
                <td>
                  <div class="mt-analytics__templateTitle">{{title}}</div>
                  <div class="mt-analytics__templateSlug">{{slug}}</div>
                </td>
                <td>{{#if created_at_str}}{{created_at_str}}{{else}}—{{/if}}</td>
                <td>{{#if deleted_at_str}}{{deleted_at_str}}{{else}}—{{/if}}</td>
                <td>{{#if first_order_at_str}}{{first_order_at_str}}{{else}}—{{/if}}</td>
                <td>{{#if last_order_at_str}}{{last_order_at_str}}{{else}}—{{/if}}</td>
                <td>{{rent_count}}</td>
                <td>{{rent_revenue_eur}}</td>
                <td>{{buy_revenue_eur}}</td>
                <td>{{total_revenue_eur}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p class="cabinet__panelText">
          No data yet. When customers buy or rent your templates, analytics will appear here.
        </p>
      {{/if}}
    </div>
  {{/if}}

</section>
