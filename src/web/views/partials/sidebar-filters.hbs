{{!-- src/web/views/partials/sidebar-filters.hbs --}}
{{!-- Templates sidebar filters (content only) --}}

<section class="templates-side__section">
  <div class="templates-side__title">Access</div>

  <div class="templates-chips templates-chips--wide" data-js="chips-access">
    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="access" value="rent" />
      <span class="chip-label">Rent</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="access" value="buy" />
      <span class="chip-label">Buy</span>
    </label>
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">Category</div>

  <div class="templates-chips templates-chips--wide" data-js="chips-category">
    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="landing" />
      <span class="chip-label">Landing pages</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="shop" />
      <span class="chip-label">E-commerce</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="blog" />
      <span class="chip-label">Blog / Media</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="portfolio" />
      <span class="chip-label">Portfolio</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="saas" />
      <span class="chip-label">SaaS / IT</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="cafe" />
      <span class="chip-label">Restaurant / Cafe</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="realty" />
      <span class="chip-label">Real estate</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="edu" />
      <span class="chip-label">Education</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="events" />
      <span class="chip-label">Events</span>
    </label>

    <label class="chip chip--toggle">
      <input class="chip-input" type="checkbox" name="category" value="medical" />
      <span class="chip-label">Healthcare</span>
    </label>
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">Price</div>

  <div class="templates-price">
    <div class="templates-price__row">
      <span>$0</span>
      <span class="templates-price__mid">$250</span>
      <span>$1000+</span>
    </div>

    <input
      class="templates-price__range"
      type="range"
      min="0"
      max="1000"
      step="10"
      value="250"
      data-js="price-range"
    />
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">License</div>

  <div class="templates-chips templates-chips--grid" data-js="chips-license">
    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="free" />
      <span class="chip-label">Free</span>
    </label>

    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="pu" />
      <span class="chip-label">PU</span>
    </label>

    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="cu" />
      <span class="chip-label">CU</span>
    </label>

    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="el" />
      <span class="chip-label">EL</span>
    </label>

    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="ml" />
      <span class="chip-label">ML</span>
    </label>

    <label class="chip chip--toggle chip--small">
      <input class="chip-input" type="checkbox" name="license" value="ex" />
      <span class="chip-label">EX</span>
    </label>
  </div>
</section>
