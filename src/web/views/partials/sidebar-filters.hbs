{{!-- Templates sidebar filters (content only) --}}

<section class="templates-side__section">
  <div class="templates-side__title">Access</div>

  <div class="templates-chips templates-chips--wide" data-js="chips-access">
    <button type="button" class="chip is-active" data-value="all">
      All
    </button>

    <button type="button" class="chip" data-value="rent">
      Rent
    </button>

    <button type="button" class="chip" data-value="buy">
      Buy
    </button>
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">Category</div>

  <div class="templates-chips templates-chips--wide" data-js="chips-category">
    <button type="button" class="chip is-active" data-value="all">All</button>
    <button type="button" class="chip" data-value="landing">Landing pages</button>
    <button type="button" class="chip" data-value="shop">E-commerce</button>
    <button type="button" class="chip" data-value="blog">Blog / Media</button>
    <button type="button" class="chip" data-value="portfolio">Portfolio</button>
    <button type="button" class="chip" data-value="saas">SaaS / IT</button>
    <button type="button" class="chip" data-value="cafe">Restaurant / Cafe</button>
    <button type="button" class="chip" data-value="realty">Real estate</button>
    <button type="button" class="chip" data-value="edu">Education</button>
    <button type="button" class="chip" data-value="events">Events</button>
    <button type="button" class="chip" data-value="medical">Healthcare</button>
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">Price</div>

  <div class="templates-price">
    <div class="templates-price__row">
      <span>$0</span>
      <span class="templates-price__mid">$250</span>
      <span>$1000+</span>
    </div>

    <input
      class="templates-price__range"
      type="range"
      min="0"
      max="1000"
      step="10"
      value="250"
      data-js="price-range"
    />
  </div>
</section>

<section class="templates-side__section">
  <div class="templates-side__title">License</div>

  <div class="templates-chips templates-chips--grid" data-js="chips-license">
    <button type="button" class="chip is-active" data-value="all">All</button>
    <button type="button" class="chip" data-value="free">Free</button>
    <button type="button" class="chip" data-value="pu">PU</button>
    <button type="button" class="chip" data-value="cu">CU</button>
    <button type="button" class="chip" data-value="el">EL</button>
    <button type="button" class="chip" data-value="ml">ML</button>
    <button type="button" class="chip" data-value="ex">EX</button>
  </div>
</section>
