{{!-- views/partials/header.hbs --}}
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo">
      <span class="logo-mark"></span>
      <span class="logo-text">
        Tempasi <span class="logo-text-accent">Templates</span>
      </span>
    </a>

    <nav class="nav-main">
      <a href="/templates" class="nav-link {{#if (eq activePage "templates")}}is-active{{/if}}">
        Шаблоны
      </a>
      <a href="/about" class="nav-link {{#if (eq activePage "about")}}is-active{{/if}}">
        About
      </a>
      <a href="/contact" class="nav-link {{#if (eq activePage "contact")}}is-active{{/if}}">
        Contact
      </a>
      <a href="/community" class="nav-link {{#if (eq activePage "community")}}is-active{{/if}}">
        Community
      </a>
      <a href="/deals" class="nav-link {{#if (eq activePage "deals")}}is-active{{/if}}">
        Скидки
      </a>
      <a href="/profile" class="nav-link {{#if (eq activePage "profile")}}is-active{{/if}}">
        Профиль
      </a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" aria-label="Поиск">
        <i class="zmdi zmdi-search"></i>
      </button>
      <button class="icon-btn" type="button" aria-label="Тема">
        <i class="zmdi zmdi-brightness-6"></i>
      </button>
      <button class="icon-btn" type="button" aria-label="Корзина">
        <i class="zmdi zmdi-shopping-cart"></i>
      </button>
    </div>
  </div>
</header>
