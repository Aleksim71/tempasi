{{!-- src/web/views/partials/space-profile-security.hbs --}}
<section class="profile-shell">

  <nav class="profile-tabs">
    {{#each workspaceData.profile.tabs}}
      <a class="profile-tab {{#if isActive}}is-active{{/if}}" href="{{href}}">
        {{label}}
      </a>
    {{/each}}
  </nav>

  {{#if (eq workspaceData.profile.tab "profile")}}
    <section class="profile-content">

      <div class="profile-section card">
        <h2 class="section-title">Basic Information</h2>

        <form class="profile-form" id="profileForm">
          <div class="form-row">
            <label for="profile_full_name">Full Name</label>
            <input
              id="profile_full_name"
              name="full_name"
              type="text"
              value="{{workspaceData.profile.form.full_name}}"
              required
            />
          </div>

          <div class="form-row">
            <label for="profile_nickname">Username</label>
            <input
              id="profile_nickname"
              name="nickname"
              type="text"
              value="{{workspaceData.profile.form.nickname}}"
              required
            />
          </div>

          <div class="form-row">
            <label for="profile_email">Email</label>
            <input
              id="profile_email"
              name="email"
              type="email"
              value="{{workspaceData.profile.form.email}}"
              readonly
            />
          </div>

          <div class="form-row">
            <label for="profile_about">About</label>
            <textarea
              id="profile_about"
              name="about"
              required
            >{{workspaceData.profile.form.about}}</textarea>
          </div>

          <div class="form-actions">
            <button type="reset" class="btn alt">Cancel</button>
            <button type="submit" class="btn primary">Save</button>
          </div>

          <div id="profileFormStatus" class="security-note" style="display:none;"></div>
        </form>
      </div>


    </section>

    <script>
      (function () {
        const form = document.getElementById('profileForm');
        const status = document.getElementById('profileFormStatus');
        if (!form || !status) return;

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          status.style.display = 'block';
          status.textContent = 'Saving...';

          const payload = {
            full_name: form.elements.full_name.value,
            nickname: form.elements.nickname.value,
            about: form.elements.about.value,
          };

          try {
            const response = await fetch('/api/profile', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (!response.ok || !data.ok) {
              status.textContent = 'Save failed.';
              return;
            }

            status.textContent = 'Saved.';
          } catch (error) {
            status.textContent = 'Network error.';
          }
        });
      })();
    </script>
  {{/if}}

  {{#if (eq workspaceData.profile.tab "security")}}
    <section class="profile-content">

      <div class="profile-section card">
        <h2 class="section-title">Password</h2>

        <form class="profile-form" id="passwordForm">
          <div class="form-row">
            <label for="password_current">Current Password</label>
            <input id="password_current" name="current_password" type="password" />
          </div>

          <div class="form-row">
            <label for="password_new">New Password</label>
            <input id="password_new" name="new_password" type="password" />
          </div>

          <div class="form-row">
            <label for="password_repeat">Repeat Password</label>
            <input id="password_repeat" name="repeat_password" type="password" />
          </div>

          <div class="form-actions">
            <button type="reset" class="btn alt">Cancel</button>
            <button type="submit" class="btn primary">Update</button>
          </div>

          <div id="passwordFormStatus" class="security-note" style="display:none;"></div>
        </form>
      </div>

    </section>

    <script>
      (function () {
        const form = document.getElementById('passwordForm');
        const status = document.getElementById('passwordFormStatus');
        if (!form || !status) return;

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          status.style.display = 'block';
          status.textContent = 'Updating...';

          const payload = {
            current_password: form.elements.current_password.value,
            new_password: form.elements.new_password.value,
            repeat_password: form.elements.repeat_password.value,
          };

          try {
            const response = await fetch('/api/profile/password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (!response.ok || !data.ok) {
              switch (data && data.error) {
                case 'PASSWORD_FIELDS_REQUIRED':
                  status.textContent = 'Fill all password fields.';
                  break;
                case 'PASSWORD_TOO_SHORT':
                  status.textContent = 'New password must be at least 8 characters.';
                  break;
                case 'PASSWORD_REPEAT_MISMATCH':
                  status.textContent = 'Passwords do not match.';
                  break;
                case 'CURRENT_PASSWORD_INVALID':
                  status.textContent = 'Current password is incorrect.';
                  break;
                default:
                  status.textContent = 'Password update failed.';
              }
              return;
            }

            form.reset();
            status.textContent = 'Password updated.';
          } catch (error) {
            status.textContent = 'Network error.';
          }
        });
      })();
    </script>
  {{/if}}

</section>
