{{!-- src/web/views/partials/space-profile-security.hbs --}}
<section class="profile-shell">

  <nav class="profile-tabs">
    {{#each workspaceData.profile.tabs}}
      <a class="tp-control tp-tab tp-tab--main {{#if isActive}}is-active{{/if}}" href="{{href}}">
        {{label}}
      </a>
    {{/each}}
  </nav>

  {{#if (eq workspaceData.profile.tab "profile")}}
    <section class="profile-content">

      <div class="profile-section card">
        <h2 class="section-title">Basic Information</h2>

        <div class="profile-avatar-row">
          <div class="profile-avatar" id="profileAvatarPreview">
            {{#if workspaceData.profile.form.avatarUrl}}
              <img src="{{workspaceData.profile.form.avatarUrl}}" alt="Profile photo" />
            {{else}}
              <div class="profile-avatar__placeholder" aria-hidden="true"></div>
            {{/if}}
          </div>
          <div class="profile-avatar-controls">
            <input type="file" id="avatarFileInput" accept="image/jpeg,image/png,image/webp" hidden />
            <button type="button" class="btn alt" id="avatarChangeBtn">Change photo</button>
            <p class="form-help">JPG, PNG or WebP, up to 2MB.</p>
            <div id="avatarUploadStatus" class="security-note" style="display:none;"></div>
          </div>
        </div>

        <form class="profile-form" id="profileForm">
          <div class="form-row">
            <label for="profile_full_name">Full Name <span aria-hidden="true">*</span></label>
            <input
              id="profile_full_name"
              name="full_name"
              type="text"
              value="{{workspaceData.profile.form.full_name}}"
              required
              oninvalid="this.setCustomValidity('Full Name is required.')"
              oninput="this.setCustomValidity('')"
            />
          </div>

          <div class="form-row">
            <label for="profile_nickname">Username <span aria-hidden="true">*</span></label>
            <input
              id="profile_nickname"
              name="nickname"
              type="text"
              value="{{workspaceData.profile.form.nickname}}"
              required
              oninvalid="this.setCustomValidity('Username is required.')"
              oninput="this.setCustomValidity('')"
            />
          </div>

          <div class="form-row">
            <label for="profile_email">Email <span aria-hidden="true">*</span></label>
            <input
              id="profile_email"
              name="email"
              type="email"
              value="{{workspaceData.profile.form.email}}"
              readonly
              required
              oninvalid="this.setCustomValidity('Email is required.')"
              oninput="this.setCustomValidity('')"
            />
          </div>

          <div class="form-row">
            <label for="profile_public_email">Public contact email</label>
            <input
              id="profile_public_email"
              name="public_email"
              type="email"
              value="{{workspaceData.profile.form.public_email}}"
              placeholder="contact@example.com"
            />
            <small class="form-help">Shown on your public template pages. Leave empty to hide.</small>
          </div>

          <div class="form-row">
            <label for="profile_about">About <span aria-hidden="true">*</span></label>
            <textarea
              id="profile_about"
              name="about"
              required
              oninvalid="this.setCustomValidity('About is required.')"
              oninput="this.setCustomValidity('')"
            >{{workspaceData.profile.form.about}}</textarea>
          </div>

          <div class="form-row form-row--checkbox">
            <label class="checkbox-label" for="profile_public_profile">
              <input
                id="profile_public_profile"
                name="public_profile"
                type="checkbox"
                {{#if workspaceData.profile.form.publicProfile}}checked{{/if}}
              />
              Show my profile in Community
            </label>
            <small class="form-help">Lets other registered users find you and your templates in the Community directory.</small>
          </div>

          <div class="form-actions">
            <button type="reset" class="btn alt">Cancel</button>
            <button type="submit" class="btn primary">Save</button>
          </div>

          <div id="profileFormStatus" class="security-note" style="display:none;"></div>
        </form>
      </div>


    </section>

    <script>
      (function () {
        const form = document.getElementById('profileForm');
        const status = document.getElementById('profileFormStatus');
        if (!form || !status) return;

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          status.style.display = 'block';
          status.textContent = 'Saving...';

          const payload = {
            full_name: form.elements.full_name.value,
            nickname: form.elements.nickname.value,
            about: form.elements.about.value,
            public_email: form.elements.public_email.value,
            public_profile: form.elements.public_profile.checked,
          };

          try {
            const response = await fetch('/api/profile', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (!response.ok || !data.ok) {
              status.textContent = data && data.message ? data.message : 'Save failed.';
              return;
            }

            status.textContent = 'Saved.';
          } catch (error) {
            status.textContent = 'Network error.';
          }
        });
      })();
    </script>

    <script>
      (function () {
        var fileInput = document.getElementById('avatarFileInput');
        var changeBtn = document.getElementById('avatarChangeBtn');
        var status = document.getElementById('avatarUploadStatus');
        var preview = document.getElementById('profileAvatarPreview');
        if (!fileInput || !changeBtn || !status || !preview) return;

        changeBtn.addEventListener('click', function () {
          fileInput.click();
        });

        fileInput.addEventListener('change', async function () {
          var file = fileInput.files[0];
          if (!file) return;

          status.style.display = 'block';
          status.textContent = 'Uploading...';

          var formData = new FormData();
          formData.append('avatar', file);

          try {
            var response = await fetch('/api/profile/avatar', {
              method: 'POST',
              body: formData,
            });
            var data = await response.json();

            if (!response.ok || !data.ok) {
              switch (data && data.error) {
                case 'ONLY_IMAGE_ALLOWED':
                  status.textContent = 'Only JPG, PNG or WebP images are allowed.';
                  break;
                case 'AVATAR_TOO_LARGE':
                  status.textContent = 'Image is too large (max 2MB).';
                  break;
                default:
                  status.textContent = 'Upload failed.';
              }
              return;
            }

            preview.innerHTML = '<img src="' + data.avatar_url + '" alt="Profile photo" />';
            status.textContent = 'Photo updated.';
          } catch (error) {
            status.textContent = 'Network error.';
          } finally {
            fileInput.value = '';
          }
        });
      })();
    </script>
  {{/if}}

  {{#if (eq workspaceData.profile.tab "security")}}
    <section class="profile-content">

      <div class="profile-section card">
        <h2 class="section-title">Password</h2>

        <form class="profile-form" id="passwordForm">
          <div class="form-row">
            <label for="password_current">Current Password</label>
            <input id="password_current" name="current_password" type="password" />
          </div>

          <div class="form-row">
            <label for="password_new">New Password</label>
            <input id="password_new" name="new_password" type="password" />
          </div>

          <div class="form-row">
            <label for="password_repeat">Repeat Password</label>
            <input id="password_repeat" name="repeat_password" type="password" />
          </div>

          <div class="form-actions">
            <button type="reset" class="btn alt">Cancel</button>
            <button type="submit" class="btn primary">Update</button>
          </div>

          <div id="passwordFormStatus" class="security-note" style="display:none;"></div>
        </form>
      </div>

      <div class="profile-section card">
        <h2 class="section-title">Delete account</h2>
        <p class="security-note">
          Your account, orders, and templates are not physically deleted — they're marked as
          closed and stop appearing publicly. If you already sold or rented templates, buyers
          keep their downloads. You will be logged out everywhere and won't be able to log back
          in. Contact support if you want this undone.
        </p>

        <form method="post" action="/cabinet/profile/delete-account" id="deleteAccountForm">
          <button type="submit" class="c-btn c-btn--danger">Delete account</button>
        </form>
      </div>

    </section>

    <script>
      (function () {
        var deleteForm = document.getElementById('deleteAccountForm');
        if (deleteForm) {
          deleteForm.addEventListener('submit', async function (e) {
            if (deleteForm.dataset.confirmed === '1') return;
            e.preventDefault();

            var ok = await window.tempasiConfirm({
              title: 'Delete your account?',
              message:
                "You'll be logged out everywhere and won't be able to log back in. Your data isn't physically deleted, but it stops appearing publicly.",
              confirmLabel: 'Delete account',
              danger: true,
            });

            if (!ok) return;
            deleteForm.dataset.confirmed = '1';
            deleteForm.submit();
          });
        }
      })();
    </script>

    <script>
      (function () {
        const form = document.getElementById('passwordForm');
        const status = document.getElementById('passwordFormStatus');
        if (!form || !status) return;

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          status.style.display = 'block';
          status.textContent = 'Updating...';

          const payload = {
            current_password: form.elements.current_password.value,
            new_password: form.elements.new_password.value,
            repeat_password: form.elements.repeat_password.value,
          };

          try {
            const response = await fetch('/api/profile/password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (!response.ok || !data.ok) {
              switch (data && data.error) {
                case 'PASSWORD_FIELDS_REQUIRED':
                  status.textContent = 'Fill all password fields.';
                  break;
                case 'PASSWORD_TOO_SHORT':
                  status.textContent = 'New password must be at least 8 characters.';
                  break;
                case 'PASSWORD_REPEAT_MISMATCH':
                  status.textContent = 'Passwords do not match.';
                  break;
                case 'CURRENT_PASSWORD_INVALID':
                  status.textContent = 'Current password is incorrect.';
                  break;
                default:
                  status.textContent = 'Password update failed.';
              }
              return;
            }

            form.reset();
            status.textContent = 'Password updated.';
          } catch (error) {
            status.textContent = 'Network error.';
          }
        });
      })();
    </script>
  {{/if}}

</section>
