{{!-- src/web/views/partials/template-card.v2.hbs --}}
{{!-- TemplateCard v2 (compat)
  Expected context:
    t: template object (current DB/view model)
  Notes:
    - Compatible with multiple field names:
      preview_url / previewUrl / preview / preview_image
      author_name / author
      rentPrice / rent_price
      buyPrice / price
    - Uses /preview/{{slug}} for Demo (matches current app)
--}}

<article class="tcard" data-template-slug="{{t.slug}}">
  <div class="tcard__media">
    <a class="tcard__thumb" href="/templates/{{t.slug}}{{#if t.selectedCaseParam}}?{{t.selectedCaseParam}}{{/if}}" aria-label="Open template details">
      <div class="template-card__no-preview" style="display:none;">Preview not available</div>

      <img
        class="tcard__img"
        src="{{#if t.previewUrl}}{{t.previewUrl}}{{else if t.preview_url}}{{t.preview_url}}{{else if t.preview}}{{t.preview}}{{else if t.preview_image}}{{t.preview_image}}{{else}}/t/{{t.slug}}/preview/preview.png{{/if}}"
        alt="Preview {{t.slug}}"
        loading="lazy"
        onerror="try{const box=this.closest('.tcard__media'); const ph=box && box.querySelector('.template-card__no-preview'); if(ph) ph.style.display='block'; this.remove();}catch(e){}"
      />
    </a>

    <div class="tcard__badges" aria-label="Template badges">
      {{#if t.isSold}}<span class="tbadge tbadge--sold">SOLD</span>{{/if}}
      {{#if t.is_new}}<span class="tbadge tbadge--new">NEW</span>{{/if}}
      {{#if t.is_popular}}<span class="tbadge tbadge--popular">POPULAR</span>{{/if}}
      {{#if t.is_exclusive}}<span class="tbadge tbadge--exclusive">EXCLUSIVE</span>{{/if}}
      {{#if t.rented_until}}<span class="tbadge tbadge--rented">RENTED</span>{{/if}}
      <span class="tbadge" title="One template = exclusive buy. Cases are only presentation placements.">Exclusive buy</span>
    </div>
  </div>

  <div class="tcard__body">
    <header class="tcard__head">
      <div class="tcard__titles">
        <h3 class="tcard__title">{{t.title}}</h3>

        <div class="tcard__seller">
          {{#if t.author}}{{t.author}}{{else}}Tempasi Studio{{/if}}
        </div>

        {{#if t.category}}
          <div class="tcard__category">{{t.category}}</div>
        {{/if}}
      </div>

      <div class="tcard__meta">
        {{#if t.pages_count}}
          <span class="tmeta">{{t.pages_count}} pages</span>
        {{/if}}
      </div>
    </header>

    {{#if t.tech}}
      <div class="tcard__tech" aria-label="Tech stack">
        {{#each t.tech}}
          <span class="tchip">{{this}}</span>
        {{/each}}
      </div>
    {{else if t.tech_stack}}
      <div class="tcard__tech" aria-label="Tech stack">
        {{#each t.tech_stack}}
          <span class="tchip">{{this}}</span>
        {{/each}}
      </div>
    {{/if}}

    <div class="tcard__cart" aria-label="Add to cart">
      {{#if t.price}}
        {{#if isAuthenticated}}
          <form method="post" action="/cart/add" class="tcard__cart-form">
            <input type="hidden" name="template_slug" value="{{t.slug}}">
            <input type="hidden" name="deal_type" value="BUY">
            <input type="hidden" name="license" value="BUY">
            <input type="hidden" name="next" value="/templates">
            <button class="tbtn tbtn--primary" type="submit">Buy {{t.price}}€</button>
          </form>
        {{else}}
          <a class="tbtn tbtn--primary" href="/login">Buy {{t.price}}€</a>
        {{/if}}
      {{/if}}

      {{#if t.prices.rent.amount}}
        {{#if isAuthenticated}}
          <button
            type="button"
            class="tbtn"
            data-rent-modal-trigger
            data-slug="{{t.slug}}"
            data-price="{{t.prices.rent.amount}}"
          >Rent {{t.prices.rent.amount}}€</button>
        {{else}}
          <a class="tbtn" href="/login">Rent {{t.prices.rent.amount}}€</a>
        {{/if}}
      {{/if}}
    </div>

    {{#if t.rented_until}}
      <div class="tcard__renteduntil">until {{t.rented_until}}</div>
    {{/if}}

    <footer class="tcard__foot">
      <div class="tcard__actions" aria-label="Template actions">
        <a class="tbtn tbtn--primary" href="/templates/{{t.slug}}/demo?back=/templates" target="_blank" rel="noopener">Demo</a>
        <a class="tbtn tbtn--ghost" href="/templates/{{t.slug}}{{#if t.selectedCaseParam}}?{{t.selectedCaseParam}}{{/if}}">Details</a>
      </div>
    </footer>
  </div>
</article>
