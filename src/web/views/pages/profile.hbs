<section class="container" style="max-width: 980px; margin: 24px auto; padding: 0 16px;">
  <h1 style="margin: 0 0 12px;">My Downloads</h1>
  <p style="margin: 0 0 20px; opacity: 0.8;">
    Здесь показаны шаблоны, доступные для скачивания в твоём аккаунте.
  </p>

  {{#if hasAny}}
    <div style="display: grid; gap: 12px;">
      {{#each entitlements}}
        <div style="border: 1px solid rgba(0,0,0,0.12); border-radius: 12px; padding: 14px 14px;">
          <div style="display:flex; align-items:flex-start; justify-content:space-between; gap: 12px;">
            <div>
              <div style="font-weight: 700; font-size: 16px;">
                {{this.template_slug}}
              </div>
              <div style="font-size: 13px; opacity: 0.75; margin-top: 6px;">
                Granted: {{this.created_at}}
                {{#if this.order_id}} • Order #{{this.order_id}}{{/if}}
              </div>
            </div>

            <div style="display:flex; gap: 10px; align-items:center;">
              <a
                href="/templates/{{this.template_slug}}"
                style="text-decoration:none; padding: 8px 10px; border-radius: 10px; border: 1px solid rgba(0,0,0,0.12);"
              >Details</a>

              <a
                href="/download/{{this.template_slug}}"
                style="text-decoration:none; padding: 8px 10px; border-radius: 10px; border: 1px solid rgba(0,0,0,0.12);"
              >Download</a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="border: 1px dashed rgba(0,0,0,0.25); border-radius: 12px; padding: 16px;">
      <div style="font-weight: 600;">Пока нет покупок</div>
      <div style="opacity: 0.8; margin-top: 6px;">
        Перейди в каталог шаблонов и купи первый шаблон.
      </div>
      <div style="margin-top: 12px;">
        <a href="/templates" style="text-decoration:none; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(0,0,0,0.12); display:inline-block;">
          Open catalog
        </a>
      </div>
    </div>
  {{/if}}
</section>
