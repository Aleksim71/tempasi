<div class="page page-profile">
  <header class="page-header">
    <h1>Профиль</h1>
    <p>Управляйте своими данными, чтобы показывать красивую карточку автора в Tempasi.</p>
  </header>

  <div class="layout">
    <!-- Боковое меню профиля: обёртка + штатный .sidebar -->
    <aside class="profile-sidebar-wrapper">
      <div class="sidebar">
        <nav class="sidebar-nav profile-nav">
          <a href="/profile" class="pill active">Профиль</a>
          <a href="/favorites" class="pill">Мои избранные</a>
          <a href="/rentals" class="pill">Мои аренды</a>
          <a href="/billing" class="pill">Billing</a>
          <a href="/deals" class="pill">Сделки</a>
        </nav>
      </div>
    </aside>

    <!-- Основное содержимое -->
    <main>
      <!-- Карточка с основными данными -->
      <section class="profile-card">
        <header class="profile-card__header">
          <div>
            <h2>Основные данные</h2>
            <p class="muted">
              Имя, ник и email будут использоваться в карточке автора и на страницах шаблонов.
            </p>
          </div>

          <div class="profile-card__actions">
            <button type="button" class="btn ghost">Отменить</button>
            <button type="submit" form="profile-main" class="btn primary">Сохранить</button>
          </div>
        </header>

        <form id="profile-main" class="profile-form">
          <div class="field-group">
            <label for="full_name">Полное имя</label>
            <input
              id="full_name"
              name="full_name"
              type="text"
              placeholder="Ваше имя"
            />
          </div>

          <div class="field-group">
            <label for="nickname">Никнейм</label>
            <input
              id="nickname"
              name="nickname"
              type="text"
              placeholder="Ваш никнейм"
            />
          </div>

          <div class="field-group">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
            />
          </div>

          <div class="field-group">
            <label for="role">Роль</label>
            <input
              id="role"
              name="role"
              type="text"
              placeholder="Дизайнер, студия, агентство…"
            />
          </div>

          <div class="field-group">
            <label for="bio">Кратко о себе</label>
            <textarea
              id="bio"
              name="bio"
              rows="4"
              placeholder="Пара предложений о том, чем вы занимаетесь."
            ></textarea>
          </div>
        </form>
      </section>

      <!-- Карточка с публичными данными -->
      <section class="profile-card">
        <header class="profile-card__header">
          <div>
            <h2>Публичный профиль</h2>
            <p class="muted">
              Эти поля отображаются на странице автора и помогают покупателям вас запомнить.
            </p>
          </div>
        </header>

        <form class="profile-form">
          <div class="field-group">
            <label for="site">Сайт или портфолио</label>
            <input
              id="site"
              name="site"
              type="url"
              placeholder="https://dribbble.com/username"
            />
          </div>

          <div class="field-group">
            <label for="social">Социальные сети</label>
            <input
              id="social"
              name="social"
              type="text"
              placeholder="@behance, @instagram, @twitter"
            />
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
