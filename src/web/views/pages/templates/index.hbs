{{!-- src/web/views/pages/templates/index.hbs --}}

<section class="templates-page">
  <header class="page-header">
    <h1>{{pageTitle}}</h1>
    {{#if pageSubtitle}}
      <p class="subtitle">{{pageSubtitle}}</p>
    {{/if}}
  </header>

  {{!-- =========================
       UX Preview styles (B10)
       ========================= --}}
  <style>
    .templates-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }

    .t-card {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: #0e1426;
      box-shadow: 0 12px 30px rgba(0,0,0,.25);
      display: flex;
      flex-direction: column;
    }

    .t-thumb {
      position: relative;
      display: block;
      border-radius: 18px;
      overflow: hidden;
    }

    .t-thumb img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      display: block;
    }

    .t-previewOverlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(10, 16, 32, 0.45);
      opacity: 0;
      transition: opacity .18s ease;
      color: #fff;
      text-decoration: none;
    }

    .t-thumb:hover .t-previewOverlay,
    .t-thumb:focus-visible .t-previewOverlay {
      opacity: 1;
    }

    .t-previewPill {
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(120, 102, 255, 0.92);
      box-shadow: 0 14px 30px rgba(0,0,0,.25);
      font: 600 14px/1.1 system-ui, -apple-system, Segoe UI, Roboto, Arial;
      letter-spacing: .2px;
      white-space: nowrap;
    }

    .t-previewHint {
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      font: 500 14px/1.1 system-ui, -apple-system, Segoe UI, Roboto, Arial;
      white-space: nowrap;
    }

    .t-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    .t-title {
      font-size: 16px;
      font-weight: 600;
      color: #fff;
    }

    .t-meta {
      font-size: 13px;
      opacity: .75;
    }

    .t-footer {
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-top: 1px solid rgba(255,255,255,.06);
    }

    .t-price {
      font-weight: 600;
      color: #fff;
    }

    .t-actions a {
      font-size: 13px;
      text-decoration: none;
      color: #9fb3ff;
    }

    .t-actions a:hover {
      text-decoration: underline;
    }
  </style>

  {{!-- =========================
       Templates grid
       ========================= --}}
  <div class="templates-grid">
    {{#each templates}}
      <article class="t-card">
        {{!-- Live preview via hover --}}
        <a
          class="t-thumb"
          href="/preview/{{slug}}"
          target="_blank"
          rel="noreferrer"
          aria-label="Live preview: {{title}}"
        >
          <img src="{{preview}}" alt="{{title}}" loading="lazy" />
          <span class="t-previewOverlay" aria-hidden="true">
            <span class="t-previewPill">▶ Live preview</span>
            <span class="t-previewHint">opens in new tab</span>
          </span>
        </a>

        <div class="t-body">
          <div class="t-title">{{title}}</div>
          <div class="t-meta">
            {{#if category}}{{category}}{{/if}}
            {{#if license}} · {{license}}{{/if}}
          </div>
        </div>

        <div class="t-footer">
          <div class="t-price">
            {{formatPrice price}}
          </div>
          <div class="t-actions">
            <a href="/templates/{{slug}}">Details →</a>
          </div>
        </div>
      </article>
    {{/each}}
  </div>
 Fletcher
</section>
