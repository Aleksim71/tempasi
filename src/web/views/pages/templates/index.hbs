{{!-- src/web/views/pages/templates/index.hbs --}}

<!-- DEBUG: TPL index.hbs ACTIVE -->

<section class="templates-page">
  <div class="templates-layout">

    {{!-- SIDEBAR (ORIGINAL, DO NOT CHANGE CONTENT) --}}
    <aside class="templates-side" aria-label="Templates filters">
      <form class="templates-filters" method="get" action="/templates">
        {{!-- Search --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Filters</div>

          <input
            class="templates-search"
            type="search"
            name="q"
            placeholder="Search (title / slug)…"
            aria-label="Search templates"
            value="{{query.q}}"
          />
        </div>

        {{!-- Access: rent / buy --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Access</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="access" value="rent" checked />
              <span class="chip-label">Rent</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="access" value="buy" checked />
              <span class="chip-label">Buy</span>
            </label>
          </div>
        </div>

        {{!-- Categories --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Categories</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="landing" /><span class="chip-label">Landing pages</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="ecommerce" /><span class="chip-label">E-commerce</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="blog" /><span class="chip-label">Blog / Media</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="portfolio" /><span class="chip-label">Portfolio</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="saas" /><span class="chip-label">SaaS / IT</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="restaurant" /><span class="chip-label">Restaurant / Café</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="real-estate" /><span class="chip-label">Real estate</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="education" /><span class="chip-label">Education</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="events" /><span class="chip-label">Events</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="health" /><span class="chip-label">Healthcare</span></label>
          </div>
        </div>

        {{!-- Price --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Price</div>

          <div class="templates-price">
            <div class="templates-price__row">
              <span>$0</span>
              <span class="templates-price__mid">$250</span>
              <span>$1000</span>
            </div>

            <input
              class="templates-price__range"
              type="range"
              min="0"
              max="1000"
              value="250"
              name="priceMax"
              aria-label="Max price"
            />

            <div class="templates-price__fields">
              <label class="templates-price__field">
                <span class="templates-price__label">Up to</span>
                <input class="templates-price__input" type="number" name="priceMaxN" min="0" max="1000" placeholder="250" />
              </label>
            </div>
          </div>
        </div>

        {{!-- Licenses --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Licenses</div>

          <div class="templates-chips templates-chips--grid">
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="PU" /><span class="chip-label">PU</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="CU" /><span class="chip-label">CU</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="EL" /><span class="chip-label">EL</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="SL" /><span class="chip-label">SL</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="ML" /><span class="chip-label">ML</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="EX" /><span class="chip-label">EX</span></label>
            <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="lic" value="RF" /><span class="chip-label">RF</span></label>
          </div>
        </div>

        {{!-- Actions --}}
        <div class="templates-side__section">
          <div class="templates-filters__meta">
            <div class="templates-count" data-js="templates-count">0/0</div>

            <div class="templates-actions">
              <button type="submit" class="chip chip--primary">Apply</button>
              <a class="chip chip--ghost" href="/templates">Reset</a>
            </div>
          </div>
        </div>
      </form>
    </aside>

    {{!-- MAIN --}}
    <div class="templates-main">
      <div class="templates-toolbar" aria-label="View mode">
        <button type="button" id="viewMini" class="view-toggle" aria-label="Mini view" aria-pressed="true">▦</button>
        <button type="button" id="viewMaxi" class="view-toggle" aria-label="Maxi view" aria-pressed="false">≡</button>
      </div>

      <section
        id="templatesView"
        class="templates-grid templates-grid--mini"
        data-js="templates-grid"
        data-view="mini"
        aria-label="Templates"
      >
        {{#each templates}}
          {{> template-card.v2 t=this }}
        {{/each}}
      </section>
    </div>

  </div>
</section>

<script>
(function () {
  const view = document.getElementById('templatesView');
  const miniBtn = document.getElementById('viewMini');
  const maxiBtn = document.getElementById('viewMaxi');
  if (!view || !miniBtn || !maxiBtn) return;

  function setPressed(miniPressed) {
    miniBtn.setAttribute('aria-pressed', miniPressed ? 'true' : 'false');
    maxiBtn.setAttribute('aria-pressed', miniPressed ? 'false' : 'true');
  }

  function setMode(mode) {
    const isMaxi = mode === 'maxi';

    view.classList.toggle('templates-grid--mini', !isMaxi);
    view.classList.toggle('templates-grid--maxi', isMaxi);

    view.dataset.view = isMaxi ? 'maxi' : 'mini';
    document.documentElement.dataset.templatesView = isMaxi ? 'maxi' : 'mini';

    miniBtn.classList.toggle('active', !isMaxi);
    maxiBtn.classList.toggle('active', isMaxi);
    setPressed(!isMaxi);

    try { localStorage.setItem('templatesView', isMaxi ? 'maxi' : 'mini'); } catch (e) {}
  }

  let saved = null;
  try { saved = localStorage.getItem('templatesView'); } catch (e) {}
  setMode(saved === 'maxi' ? 'maxi' : 'mini');

  miniBtn.addEventListener('click', (e) => { e.preventDefault(); setMode('mini'); });
  maxiBtn.addEventListener('click', (e) => { e.preventDefault(); setMode('maxi'); });
})();
</script>
