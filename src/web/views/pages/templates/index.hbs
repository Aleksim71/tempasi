{{!-- src/web/views/pages/templates/index.hbs --}}

<style>
  /* =========================
     Grid
     ========================= */
  .templates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  /* content-visibility boosts large lists */
  .t-card {
    background: #0e1426;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0,0,0,.25);
    display: flex;
    flex-direction: column;

    content-visibility: auto;
    contain-intrinsic-size: 340px; /* reserve space to reduce jumps */
  }

  /* =========================
     Thumbnail + preview UX
     ========================= */
  .t-thumb {
    position: relative;
    display: block;
    overflow: hidden;

    /* CLS killer: reserve space before image loads */
    aspect-ratio: 16 / 9;
    background: rgba(255,255,255,.04);
  }

  .t-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay */
  .t-previewOverlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: rgba(10, 16, 32, 0.45);
    opacity: 0;
    transition: opacity .18s ease;
  }

  /* Desktop hover */
  @media (hover: hover) and (pointer: fine) {
    .t-thumb:hover .t-previewOverlay {
      opacity: 1;
    }
  }

  /* Mobile: overlay always visible */
  @media (hover: none) and (pointer: coarse) {
    .t-previewOverlay {
      opacity: 1;
      background: linear-gradient(
        to top,
        rgba(10,16,32,.78),
        rgba(10,16,32,.28) 55%,
        rgba(10,16,32,.05)
      );
      align-items: flex-end;
      padding: 12px;
    }
  }

  .t-previewPill,
  .t-previewHint {
    pointer-events: auto;
    padding: 12px 16px;
    border-radius: 999px;
    font: 600 14px/1 system-ui, -apple-system, Segoe UI, Roboto, Arial;
    white-space: nowrap;
    text-decoration: none;
  }

  .t-previewPill {
    background: rgba(120, 102, 255, 0.95);
    color: #fff;
    box-shadow: 0 12px 26px rgba(0,0,0,.3);
  }

  .t-previewHint {
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.2);
    color: #fff;
  }

  /* =========================
     Card body
     ========================= */
  .t-body {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .t-title {
    font-weight: 700;
    color: #fff;
  }

  .t-meta {
    font-size: 13px;
    opacity: .75;
  }

  .t-footer {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,.06);
  }

  .t-price {
    font-weight: 700;
    color: #fff;
  }

  .t-actions a {
    font-size: 13px;
    color: #9fb3ff;
    text-decoration: none;
  }
</style>

<section class="templates-page">
  <header class="page-header">
    <h1>{{pageTitle}}</h1>
    {{#if pageSubtitle}}
      <p class="subtitle">{{pageSubtitle}}</p>
    {{/if}}
  </header>

  <div class="templates-grid">
    {{#each templates}}
      <article class="t-card">

        <div class="t-thumb">
          <img src="{{preview}}" alt="{{title}}" loading="lazy" decoding="async" />
          <div class="t-previewOverlay">
            <a class="t-previewPill" href="/preview/{{slug}}" target="_blank" rel="noreferrer">
              ▶ Preview
            </a>
            <a class="t-previewHint" href="/templates/{{slug}}">
              Details
            </a>
          </div>
        </div>

        <div class="t-body">
          <div class="t-title">{{title}}</div>
          <div class="t-meta">
            {{category}} · {{licenseLabel license}}
          </div>
        </div>

        <div class="t-footer">
          <div class="t-price">{{formatPrice price}}</div>
          <div class="t-actions">
            <a href="/templates/{{slug}}">Open →</a>
          </div>
        </div>

      </article>
    {{/each}}
  </div>
</section>
