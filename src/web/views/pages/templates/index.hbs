{{!-- ========================= --}}
{{!-- Templates Catalog (B11) --}}
{{!-- ========================= --}}

<section class="templates-page">

  <header class="templates-header">
    <h1 class="page-title">Templates</h1>
    <p class="page-subtitle">
      Ready-to-use website templates. Preview online, download ZIP when ready.
    </p>
  </header>

  {{!-- Chip-bar filters (B11.3) --}}
  <section class="chipbar" data-chipbar>
    <button class="chip" type="button" data-filter="zipReady">ZIP ready</button>
    <button class="chip" type="button" data-filter="free">Free</button>

    <div class="chip-group" role="group" aria-label="License">
      <button class="chip" type="button" data-filter="license" data-value="PU">PU</button>
      <button class="chip" type="button" data-filter="license" data-value="CU">CU</button>
      <button class="chip" type="button" data-filter="license" data-value="EL">EL</button>
    </div>

    <button class="chip chip--ghost" type="button" data-action="reset">Reset</button>
  </section>

  <section class="templates-grid">
    {{#each templates}}

      <article
        class="tpl-card {{#unless zipReady}}is-zip-not-ready{{/unless}} {{#if (eq license "FREE")}}is-free{{/if}}"
        data-tpl-card
        data-slug="{{slug}}"
        data-license="{{license}}"
        data-deal="{{deal}}"
        data-zip-ready="{{#if zipReady}}1{{else}}0{{/if}}"
      >

        <div class="tpl-card__badges">
          <span class="badge badge--license badge--{{license}}">{{license}}</span>

          {{#if (eq deal "RENT")}}
            <span class="badge badge--deal badge--RENT">RENT</span>
          {{else if (eq deal "BUY")}}
            <span class="badge badge--deal badge--BUY">BUY</span>
          {{else}}
            <span class="badge badge--deal badge--FREE">FREE</span>
          {{/if}}

          {{#if zipReady}}
            <span class="badge badge--zip badge--READY">ZIP READY</span>
          {{else}}
            <span class="badge badge--zip badge--NOT_READY">ZIP NOT READY</span>
          {{/if}}
        </div>

        {{!-- Preview image: fallback to /t/:slug/preview/preview.png --}}
        <a class="tpl-card__preview" href="/preview/{{slug}}" aria-label="Open preview {{title}}">
          <img
            src="{{#if previewUrl}}{{previewUrl}}{{else}}/t/{{slug}}/preview/preview.png{{/if}}"
            alt="Preview {{title}}"
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="tpl-card__footer">
          <h3 class="tpl-card__title">{{title}}</h3>

          <div class="tpl-card__actions">
            <a class="btn btn-secondary" href="/preview/{{slug}}">Preview</a>

            {{#if zipReady}}
              <a class="btn btn-primary" href="/download/{{slug}}">Download ZIP</a>
            {{else}}
              <button class="btn btn-primary is-disabled" type="button" disabled>ZIP soon</button>
            {{/if}}
          </div>
        </div>

      </article>

    {{/each}}

    {{#unless templates.length}}
      <div class="templates-empty">No templates found.</div>
    {{/unless}}
  </section>

</section>

<script src="/js/templates.filters.js" defer></script>
