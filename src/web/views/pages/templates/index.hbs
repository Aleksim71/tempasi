{{!-- src/web/views/pages/templates/index.hbs --}}

<!-- DEBUG: TPL index.hbs ACTIVE -->

<section class="templates-page">
  <div class="templates-layout">

    {{!-- SIDEBAR (ORIGINAL, DO NOT CHANGE CONTENT) --}}
    <aside class="templates-side" aria-label="Templates filters">
      <form class="templates-filters" method="get" action="/templates">
        {{#if selectedCaseId}}<input type="hidden" name="caseId" value="{{selectedCaseId}}">{{/if}}
        {{!-- Search --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Filters</div>

          <input
            class="templates-search"
            type="search"
            name="q"
            placeholder="Search (title / slug)…"
            aria-label="Search templates"
            value="{{query.q}}"
          />
        </div>

        {{!-- Access: rent / buy --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Access</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle chip--access-radio">
              <input class="chip-input chip-input--access-radio" type="radio" name="access" value="rent" {{#if (eq query.access "rent")}}checked{{/if}} />
              <span class="chip-radio-dot" aria-hidden="true"></span>
              <span class="chip-label">Buy + Rent</span>
            </label>

            <label class="chip chip--toggle chip--access-radio">
              <input class="chip-input chip-input--access-radio" type="radio" name="access" value="buy" {{#if (eq query.access "buy")}}checked{{/if}} />
              <span class="chip-radio-dot" aria-hidden="true"></span>
              <span class="chip-label">Buy only</span>
            </label>
          </div>
        </div>

        {{!-- Categories --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Categories</div>

          <div class="templates-chips templates-chips--wide">
            {{#each categoryOptions}}
              <label class="chip chip--toggle"><input class="chip-input" type="checkbox" name="cat" value="{{this.slug}}" {{#if this.checked}}checked{{/if}} /><span class="chip-label">{{this.label}}</span></label>
            {{/each}}
          </div>
        </div>

        {{!-- Price --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Price</div>

          <div class="templates-price">
            <div class="templates-price__row">
              <span>$0</span>
              <span class="templates-price__mid">$250</span>
              <span>$1000</span>
            </div>

            <input
              class="templates-price__range"
              type="range"
              min="0"
              max="1000"
              value="{{#if query.priceActive}}{{query.priceMax}}{{else}}250{{/if}}"
              name="priceMax"
              aria-label="Max price"
            />

            {{!-- Only submitted as an active filter once the user has
                 touched the slider/number field — see
                 templates.catalog-filters.js. Prevents the slider's
                 resting default (250) from silently filtering results
                 on first render. --}}
            <input type="hidden" name="priceActive" id="priceActiveFlag" value="{{#if query.priceActive}}1{{else}}0{{/if}}">

            <div class="templates-price__fields">
              <label class="templates-price__field">
                <span class="templates-price__label">Up to</span>
                <input class="templates-price__input" type="number" name="priceMaxN" min="0" max="1000" placeholder="250" value="{{#if query.priceActive}}{{query.priceMax}}{{/if}}" />
              </label>
            </div>
          </div>
        </div>

        {{!-- Selling options --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Selling options</div>

          <div class="templates-chips templates-chips--grid">
          </div>
        </div>

        {{!-- Per page --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Per page</div>

          <select class="templates-pagesize" name="pageSize" aria-label="Templates per page">
            {{#each pagination.pageSizeOptions}}
              <option value="{{this.value}}" {{#if this.isCurrent}}selected{{/if}}>{{this.value}}</option>
            {{/each}}
          </select>
        </div>

        {{!-- Actions --}}
        <div class="templates-side__section">
          <div class="templates-filters__meta">
            <div class="templates-count" data-js="templates-count">{{pagination.rangeStart}}–{{pagination.rangeEnd}} of {{pagination.total}}</div>

            <div class="templates-actions">
              <button type="submit" class="chip chip--primary">Apply</button>
              <a class="chip chip--ghost" href="/templates{{#if selectedCaseParam}}?{{selectedCaseParam}}{{/if}}">Reset</a>
            </div>
          </div>
        </div>
      </form>
    </aside>

    {{!-- MAIN --}}
    <div class="templates-main">
      <div class="templates-toolbar" aria-label="View mode">
        <button type="button" id="viewMini" class="view-toggle" aria-label="Mini view" aria-pressed="true">▦</button>
        <button type="button" id="viewMaxi" class="view-toggle" aria-label="Maxi view" aria-pressed="false">≡</button>
      </div>

      <section
        id="templatesView"
        class="templates-grid templates-grid--mini"
        data-js="templates-grid"
        data-view="mini"
        aria-label="Templates"
      >
        {{#each templates}}
          {{> template-card.v2 t=this isAuthenticated=../isAuthenticated }}
        {{/each}}
      </section>

      {{#if (not (eq pagination.totalPages 1))}}
        <nav class="templates-pagination" aria-label="Templates pagination">
          {{#if pagination.hasPrev}}
            <a class="templates-pagination__nav" href="{{pagination.prevUrl}}" rel="prev">‹ Prev</a>
          {{else}}
            <span class="templates-pagination__nav templates-pagination__nav--disabled" aria-disabled="true">‹ Prev</span>
          {{/if}}

          {{#each pagination.pages}}
            {{#if this.isCurrent}}
              <span class="templates-pagination__page templates-pagination__page--current" aria-current="page">{{this.page}}</span>
            {{else}}
              <a class="templates-pagination__page" href="{{this.url}}">{{this.page}}</a>
            {{/if}}
          {{/each}}

          {{#if pagination.hasNext}}
            <a class="templates-pagination__nav" href="{{pagination.nextUrl}}" rel="next">Next ›</a>
          {{else}}
            <span class="templates-pagination__nav templates-pagination__nav--disabled" aria-disabled="true">Next ›</span>
          {{/if}}
        </nav>
      {{/if}}
    </div>

  </div>
</section>

<div id="rentModal" class="rent-modal" hidden>
  <div class="rent-modal__backdrop" data-rent-modal-close></div>
  <div class="rent-modal__panel" role="dialog" aria-modal="true" aria-labelledby="rentModalTitle">
    <button type="button" class="rent-modal__close" data-rent-modal-close aria-label="Close">&times;</button>
    <h3 id="rentModalTitle" class="rent-modal__title">Rent <span id="rentModalPrice"></span></h3>

    <form method="post" action="/cart/add" id="rentModalForm">
      <input type="hidden" name="template_slug" id="rentModalSlug" value="">
      <input type="hidden" name="deal_type" value="RENT">
      <input type="hidden" name="license" value="PU">
      <input type="hidden" name="next" value="/templates">

      <div class="rent-modal__field">
        <label for="rentModalDays">Days</label>
        <input type="number" min="1" step="1" name="rent_days" id="rentModalDays" value="1" required>
      </div>

      <div class="rent-modal__field">
        <label>Cases</label>
        {{#if userCases.length}}
          <div class="rent-modal__cases">
            {{#each userCases}}
              <label class="rent-modal__case">
                <input type="checkbox" name="case_ids" value="{{this.id}}">
                <span>{{this.title}}</span>
              </label>
            {{/each}}
          </div>
        {{else}}
          <p class="rent-modal__empty">No cases yet. You can create a case in Cabinet.</p>
        {{/if}}
      </div>

      <div class="rent-modal__actions">
        <button type="button" class="tbtn" data-rent-modal-close>Cancel</button>
        <button type="submit" class="tbtn tbtn--primary">Add rent to cart</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  const modal = document.getElementById('rentModal');
  if (!modal) return;

  const slugInput = document.getElementById('rentModalSlug');
  const priceEl = document.getElementById('rentModalPrice');
  const daysInput = document.getElementById('rentModalDays');

  function openModal(slug, price) {
    slugInput.value = slug || '';
    priceEl.textContent = price ? price + '€' : '';
    daysInput.value = '1';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-rent-modal-trigger]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openModal(btn.getAttribute('data-slug'), btn.getAttribute('data-price'));
    });
  });

  modal.querySelectorAll('[data-rent-modal-close]').forEach(function (el) {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
</script>

<script>
(function () {
  const view = document.getElementById('templatesView');
  const miniBtn = document.getElementById('viewMini');
  const maxiBtn = document.getElementById('viewMaxi');
  if (!view || !miniBtn || !maxiBtn) return;

  function setPressed(miniPressed) {
    miniBtn.setAttribute('aria-pressed', miniPressed ? 'true' : 'false');
    maxiBtn.setAttribute('aria-pressed', miniPressed ? 'false' : 'true');
  }

  function setMode(mode) {
    const isMaxi = mode === 'maxi';

    view.classList.toggle('templates-grid--mini', !isMaxi);
    view.classList.toggle('templates-grid--maxi', isMaxi);

    view.dataset.view = isMaxi ? 'maxi' : 'mini';
    document.documentElement.dataset.templatesView = isMaxi ? 'maxi' : 'mini';

    miniBtn.classList.toggle('active', !isMaxi);
    maxiBtn.classList.toggle('active', isMaxi);
    setPressed(!isMaxi);

    try { localStorage.setItem('templatesView', isMaxi ? 'maxi' : 'mini'); } catch (e) {}
  }

  let saved = null;
  try { saved = localStorage.getItem('templatesView'); } catch (e) {}
  setMode(saved === 'maxi' ? 'maxi' : 'mini');

  miniBtn.addEventListener('click', (e) => { e.preventDefault(); setMode('mini'); });
  maxiBtn.addEventListener('click', (e) => { e.preventDefault(); setMode('maxi'); });
})();
</script>

<script src="/js/templates.catalog-filters.js" defer></script>
