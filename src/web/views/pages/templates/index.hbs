{{!-- src/web/views/pages/templates/index.hbs --}}

<!-- DEBUG: TPL index.hbs ACTIVE -->

<section class="templates-page">
  <div class="templates-layout">
    {{!-- SIDEBAR --}}
    <aside class="templates-side" aria-label="Templates filters">
      <form class="templates-filters" method="get" action="/templates">
        {{!-- Search --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Filters</div>

          <input
            class="templates-search"
            type="search"
            name="q"
            placeholder="Search (title / slug)…"
            aria-label="Search templates"
            value="{{query.q}}"
          />
        </div>

        {{!-- Access: rent / buy --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Access</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="access" value="rent" checked />
              <span class="chip-label">Rent</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="access" value="buy" checked />
              <span class="chip-label">Buy</span>
            </label>
          </div>
        </div>

        {{!-- ZIP status --}}
        <div class="templates-side__section">
          <div class="templates-side__title">ZIP status</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle">
              <input class="chip-input" type="radio" name="zip" value="" checked />
              <span class="chip-label">All</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="radio" name="zip" value="ready" />
              <span class="chip-label">ZIP ready</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="radio" name="zip" value="not-ready" />
              <span class="chip-label">Not ready</span>
            </label>
          </div>
        </div>

        {{!-- Categories --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Categories</div>

          <div class="templates-chips templates-chips--wide">
            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="landing" />
              <span class="chip-label">Landing pages</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="ecommerce" />
              <span class="chip-label">E-commerce</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="blog" />
              <span class="chip-label">Blog / Media</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="portfolio" />
              <span class="chip-label">Portfolio</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="saas" />
              <span class="chip-label">SaaS / IT</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="restaurant" />
              <span class="chip-label">Restaurant / Café</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="real-estate" />
              <span class="chip-label">Real estate</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="education" />
              <span class="chip-label">Education</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="events" />
              <span class="chip-label">Events</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="cat" value="health" />
              <span class="chip-label">Healthcare</span>
            </label>
          </div>
        </div>

        {{!-- Price --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Price</div>

          <div class="templates-price">
            <div class="templates-price__row">
              <span>$0</span>
              <span class="templates-price__mid">$250</span>
              <span>$1000</span>
            </div>

            <input
              class="templates-price__range"
              type="range"
              min="0"
              max="1000"
              value="250"
              name="priceMax"
              aria-label="Max price"
            />

            <div class="templates-price__fields">
              <label class="templates-price__field">
                <span class="templates-price__label">Up to</span>
                <input class="templates-price__input" type="number" name="priceMaxN" min="0" max="1000" placeholder="250" />
              </label>
            </div>
          </div>
        </div>

        {{!-- Licenses --}}
        <div class="templates-side__section">
          <div class="templates-side__title">Licenses</div>

          <div class="templates-chips templates-chips--grid">
            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="PU" />
              <span class="chip-label">PU</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="CU" />
              <span class="chip-label">CU</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="EL" />
              <span class="chip-label">EL</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="SL" />
              <span class="chip-label">SL</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="ML" />
              <span class="chip-label">ML</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="EX" />
              <span class="chip-label">EX</span>
            </label>

            <label class="chip chip--toggle">
              <input class="chip-input" type="checkbox" name="lic" value="RF" />
              <span class="chip-label">RF</span>
            </label>
          </div>
        </div>

        {{!-- Actions --}}
        <div class="templates-side__section">
          <div class="templates-filters__meta">
            <div class="templates-count" data-js="templates-count">0/0</div>

            <div class="templates-actions">
              <button type="submit" class="chip chip--primary">Apply</button>
              <a class="chip chip--ghost" href="/templates">Reset</a>
            </div>
          </div>
        </div>

        {{!-- Quick links --}}
        <nav class="templates-side__section" aria-label="Quick links">
          <div class="templates-side__title">Quick</div>
          <div class="templates-side__links">
            <a class="templates-side__link" href="/templates">Templates</a>
            <a class="templates-side__link" href="/pricing">Pricing</a>
            <a class="templates-side__link" href="/how-it-works">How it works</a>
            <a class="templates-side__link" href="/contact">Support</a>
          </div>
        </nav>
      </form>
    </aside>

    {{!-- MAIN --}}
    <div class="templates-main">
      <header class="templates-hero">
        <h1 class="templates-title">Templates</h1>
        <p class="templates-subtitle">
          Ready-to-use website templates. Preview online, download ZIP when ready.
        </p>
      </header>

      <section class="templates-grid" data-js="templates-grid" aria-label="Templates">
        {{#each templates}}
          <article class="template-card" data-template-slug="{{this.slug}}">
            <div class="template-card__preview">
              <div class="template-card__no-preview" style="display:none;">Preview not available</div>

              <img
                src="{{#if this.previewUrl}}{{this.previewUrl}}{{else}}/t/{{this.slug}}/preview.png{{/if}}"
                alt="Preview {{this.slug}}"
                loading="lazy"
                onerror="try{const box=this.closest('.template-card__preview'); const ph=box && box.querySelector('.template-card__no-preview'); if(ph) ph.style.display='block'; this.remove();}catch(e){}"
              />
            </div>

            <div class="template-card__body">
              <div class="template-card__meta">
                <span class="template-card__badge">
                  {{#if this.zipReady}}ZIP READY{{else}}NOT READY{{/if}}
                </span>

                {{#if this.license}}
                  <span class="template-card__license">{{this.license}}</span>
                {{/if}}
              </div>

              <div class="template-card__slug">{{this.slug}}</div>

              <div class="template-card__actions">
                <a class="template-card__link" href="/templates/{{this.slug}}">Preview</a>

                {{#if this.zipReady}}
                  <a class="template-card__btn" href="/api/templates/{{this.slug}}/download">Download</a>
                {{else}}
                  <span class="template-card__btn is-disabled" aria-disabled="true">Download</span>
                {{/if}}
              </div>
            </div>
          </article>
        {{/each}}
      </section>
    </div>
  </div>
</section>
