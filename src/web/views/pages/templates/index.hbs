
{{!-- src/web/views/pages/templates/index.hbs --}}

<section class="templates-page">
  <div class="container">

    <header class="templates-hero">
      <h1 class="templates-title">Templates</h1>
      <p class="templates-subtitle">
        Ready-to-use website templates. Preview online, download ZIP when ready.
      </p>
    </header>

    <section class="templates-filters" aria-label="Filters">
      <div class="templates-filters__row">
        <input
          class="templates-search"
          type="search"
          placeholder="Search (title / slug)..."
          aria-label="Search templates"
          data-js="templates-search"
        />

        <div class="templates-chips" aria-label="ZIP status" data-js="chips-zip">
          <button type="button" class="c-chip is-active" data-chip="all">All</button>
          <button type="button" class="c-chip" data-chip="zip-ready">ZIP ready</button>
          <button type="button" class="c-chip" data-chip="zip-not-ready">Not ready</button>
        </div>

        <div class="templates-chips" aria-label="License" data-js="chips-license">
          <button type="button" class="c-chip is-active" data-chip="all">All</button>
          <button type="button" class="c-chip" data-chip="free">Free</button>
          <button type="button" class="c-chip" data-chip="pu">PU</button>
          <button type="button" class="c-chip" data-chip="cu">CU</button>
          <button type="button" class="c-chip" data-chip="el">EL</button>
          <button type="button" class="c-chip" data-chip="ml">ML</button>
          <button type="button" class="c-chip" data-chip="ex">EX</button>
          <button type="button" class="c-chip" data-chip="reset">Reset</button>
        </div>

        <div class="templates-chips" aria-label="Brand" data-js="chips-brand">
          <button type="button" class="c-chip" data-chip="brand-gold">Brand: Gold</button>
          <button type="button" class="c-chip" data-chip="brand-red">Brand: Red</button>
          <button type="button" class="c-chip" data-chip="brand-amber">Brand: Amber</button>
        </div>

        <div class="templates-filters__meta">
          <div class="templates-count" data-js="templates-count">0/0</div>
        </div>
      </div>
    </section>

    <section class="templates-grid" data-js="templates-grid" aria-label="Templates">
      {{#each templates}}
        <article class="template-card" data-template-card data-slug="{{slug}}">

          <div class="template-card__top">
            {{#if zipReady}}
              <span class="c-chip c-chip--success">ZIP READY</span>
            {{else}}
              <span class="c-chip">ZIP NOT READY</span>
            {{/if}}

            {{#if license}}
              <span class="c-chip">{{license}}</span>
            {{/if}}
          </div>

          {{!-- IMPORTANT: /t is the only real preview source in current setup --}}
          <a class="template-card__preview" href="/preview/{{slug}}">
            <img
              class="template-card__img"
              src="/t/{{slug}}/preview/preview.png"
              alt="{{title}} preview"
              loading="lazy"
              onload="this.closest('.template-card__preview')?.classList.remove('is-error');"
              onerror="this.onerror=null; this.closest('.template-card__preview')?.classList.add('is-error');"
            />
            <div class="template-card__placeholder">Preview not available</div>
          </a>

          <div class="template-card__body">
            <h3 class="template-card__title">{{title}}</h3>
            <div class="template-card__meta">{{slug}}</div>
          </div>

          <div class="template-card__actions">
            <a class="c-btn c-btn--ghost" href="/preview/{{slug}}">Preview</a>

            {{#if zipReady}}
              <a class="c-btn c-btn--primary" href="/download/{{slug}}">Download</a>
            {{else}}
              <a class="c-btn c-btn--primary" href="/{{slug}}/buy">Buy</a>
            {{/if}}
          </div>

        </article>
      {{/each}}
    </section>

  </div>
</section>
