<main class="page">
  <div class="profile-layout">

    <!-- LEFT MENU -->
    <aside class="profile-menu">
      <a class="menu-item is-active">Profile</a>
      <a class="menu-item">My favorites</a>
      <a class="menu-item">My rentals</a>
      <a class="menu-item">Billing</a>
      <a class="menu-item">Deals</a>
    </aside>

    <!-- RIGHT COLUMN — Basic info + Public profile -->
    <section class="profile-content">

      <!-- BASIC INFO -->
      <div class="profile-section card">
        <h2 class="section-title">Basic info</h2>

        <form class="profile-form">
          <div class="form-row">
            <label>Full name</label>
            <input type="text" placeholder="Your name" />
          </div>

          <div class="form-row">
            <label>Nickname</label>
            <input type="text" placeholder="Your nickname" />
          </div>

          <div class="form-row">
            <label>Email</label>
            <input type="email" placeholder="you@example.com" />
          </div>

          <div class="form-row">
            <label>Role</label>
            <input type="text" placeholder="Designer, studio, agency..." />
          </div>

          <div class="form-row">
            <label>Short bio</label>
            <textarea placeholder="A couple of sentences about what you do."></textarea>
          </div>

          <div class="form-actions">
            <button type="button" class="btn alt">Cancel</button>
            <button type="submit" class="btn primary">Save</button>
          </div>
        </form>
      </div>

      <!-- PUBLIC PROFILE -->
      <div class="profile-section card">
        <h2 class="section-title">Public profile</h2>

        <form class="profile-form">
          <div class="form-row">
            <label>Website or portfolio</label>
            <input type="text" placeholder="https://dribbble.com/username" />
          </div>

          <div class="form-row">
            <label>Social media</label>
            <input type="text" placeholder="@behance, @instagram, @twitter" />
          </div>

          <div class="form-row">
            <label>Bio</label>
            <textarea placeholder="Tell us a bit about yourself for your author page."></textarea>
          </div>
        </form>
      </div>

    </section>
  </div>
</main>
