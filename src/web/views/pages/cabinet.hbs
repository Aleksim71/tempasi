{{!-- src/web/views/pages/cabinet.hbs --}}
<section class="cabinet">
  <div class="container">
    <div class="cabinet__layout">

      <aside class="cabinet__sidebar">
        <div class="cabinet__sidebarTitle">Cabinet</div>

        <nav class="cabinet__nav" aria-label="Cabinet navigation">
          <a class="cabinet__navItem {{#if (eq activeSpace 'cases')}}is-active{{/if}}" href="/cabinet/cases">
            <span>Cases</span>
            <span class="cabinet__navMeta">Work</span>
          </a>

          <a class="cabinet__navItem {{#if (eq activeSpace 'my-templates')}}is-active{{/if}}" href="/cabinet/my-templates">
            <span>My Templates</span>
            <span class="cabinet__navMeta">Library</span>
          </a>

          <a class="cabinet__navItem {{#if (eq activeSpace 'finance')}}is-active{{/if}}" href="/cabinet/finance">
            <span>Finance</span>
            <span class="cabinet__navMeta">Orders</span>
          </a>

          <a class="cabinet__navItem {{#if (eq activeSpace 'profile')}}is-active{{/if}}" href="/cabinet/profile">
            <span>Profile &amp; Security</span>
            <span class="cabinet__navMeta">Account</span>
          </a>

          <a class="cabinet__navItem {{#if (eq activeSpace 'support')}}is-active{{/if}}" href="/cabinet/support">
            <span>Support</span>
            <span class="cabinet__navMeta">Help</span>
          </a>
        </nav>
      </aside>

      <main class="cabinet__workspace">
        <h1 class="cabinet__title">{{pageTitle}}</h1>
        <p class="cabinet__subtitle">{{pageSubtitle}}</p>

        <div class="cabinet__panel">
          <div class="cabinet__panelTitle">{{panelTitle}}</div>
          <p class="cabinet__panelText">{{panelText}}</p>
        </div>
      </main>

    </div>
  </div>
</section>
