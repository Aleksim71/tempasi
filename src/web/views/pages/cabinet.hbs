{{!-- src/web/views/pages/cabinet.hbs --}}
<link rel="stylesheet" href="/css/pages/cabinet.css" />

<section class="cabinet">
  <div class="l-container">
    <div class="cabinet__layout">

      <aside class="cabinet__sidebar side">

        <div class="side__title">Cabinet</div>

        <nav class="side__nav" aria-label="Cabinet navigation">
          <a class="side__link {{#if (eq activeSpace 'my-templates')}}is-active{{/if}}" href="/cabinet/my-templates">
            <span>My Templates</span>
            <span class="side__meta">Library</span>
          </a>

          <a class="side__link {{#if (eq activeSpace 'cases')}}is-active{{/if}}" href="/cabinet/cases">
            <span>Cases</span>
            <span class="side__meta">Work</span>
          </a>

          <a class="side__link {{#if (eq activeSpace 'finance')}}is-active{{/if}}" href="/cabinet/finance">
            <span>Finance</span>
            <span class="side__meta">Orders</span>
          </a>

          <a class="side__link {{#if (eq activeSpace 'profile')}}is-active{{/if}}" href="/cabinet/profile">
            <span>Profile &amp; Security</span>
            <span class="side__meta">Account</span>
          </a>

          <a class="side__link {{#if (eq activeSpace 'support')}}is-active{{/if}}" href="/cabinet/support">
            <span>Support</span>
            <span class="side__meta">Help</span>
          </a>
        </nav>

      </aside>

      <main class="cabinet__workspace">

        {{!-- Title/subtitle are hidden for My Templates, Profile, Finance, and Support
             workspaces (Finance builds its own Overview period/BUY/RENT/Balance layout
             without a page-level heading, see space-finance.hbs) --}}
        {{#unless (or (eq activeSpace 'my-templates') (eq activeSpace 'profile') (eq activeSpace 'finance') (eq activeSpace 'support'))}}
          <h1 class="cabinet__title">{{pageTitle}}</h1>
          <p class="cabinet__subtitle">{{pageSubtitle}}</p>
        {{/unless}}

        {{!-- Active space content --}}
        {{#if (eq activeSpace 'my-templates')}}
          {{> space-my-templates}}
        {{/if}}

        {{#if (eq activeSpace 'cases')}}
          {{> space-cases}}
        {{/if}}

        {{#if (eq activeSpace 'finance')}}
          {{> space-finance}}
        {{/if}}

        {{#if (eq activeSpace 'profile')}}
          {{> space-profile-security}}
        {{/if}}

        {{#if (eq activeSpace 'support')}}
          {{> space-support}}
        {{/if}}

      </main>

    </div>
  </div>
</section>
