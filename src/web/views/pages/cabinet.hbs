{{!-- src/web/views/pages/cabinet.hbs --}}
<link rel="stylesheet" href="/css/pages/cabinet.css" />
<link rel="stylesheet" href="/css/pages/cabinet-cases.css" />

<section class="cabinet-page" data-page="cabinet">
  <header class="cabinet-hero">
    <h1 class="cabinet-title">Cabinet</h1>
    <p class="cabinet-subtitle">
      Workspace for your client shortlists and ongoing projects.
    </p>
  </header>

  <div class="cabinet-panel" role="region" aria-label="Cabinet">

    <div class="cabinet-actions">
      <a class="btn" href="/cabinet/cases">Cases</a>
      <a class="btn btn--ghost" href="/cabinet/cases/new">Create case</a>
    </div>

    <section class="panel" aria-label="Recent cases">
      <div class="panel__head">
        <h2>Recent cases</h2>
        <p class="muted">
          Continue working on your latest client shortlists.
        </p>
      </div>

      {{#if recentCases.length}}
        <div class="cases-grid" role="list">
          {{#each recentCases}}
            <article class="case-card" role="listitem">
              <div class="case-card__head">
                <h3 class="case-card__title">
                  <a href="/cabinet/cases/{{id}}">{{title}}</a>
                </h3>
                <div class="case-card__meta muted">
                  {{templates_count}} templates · updated {{updated_at}}
                </div>
              </div>

              <div class="case-card__footer">
                <a class="btn btn--ghost" href="/cabinet/cases/{{id}}">
                  Open
                </a>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-state empty-state--compact">
          <div class="empty-state__title">No cases yet</div>
          <div class="empty-state__hint">
            Create your first case for a client and add templates to present.
          </div>
          <div class="empty-state__actions">
            <a class="btn" href="/cabinet/cases/new">Create case</a>
          </div>
        </div>
      {{/if}}
    </section>

    <section class="panel" aria-label="Coming soon">
      <div class="panel__head">
        <h2>Coming soon</h2>
        <p class="muted">
          Favorites, Orders, Downloads, Templates, Billing, Settings.
        </p>
      </div>
    </section>

  </div>
</section>
