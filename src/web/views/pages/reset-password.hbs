<div class="auth-card">
  <div class="auth-tabs">
    <a href="/login" class="auth-tab">Sign in</a>
    <a href="/register" class="auth-tab">Register</a>
  </div>

  <h1 class="auth-title">Reset password</h1>

  {{!-- Error banner --}}
  {{#if errors}}
    <div class="auth-banner auth-banner--error">
      {{errors.[0]}}
    </div>
  {{/if}}

  {{!-- Success / info note --}}
  {{#if note}}
    <div class="auth-banner auth-banner--ok">
      {{note}}
    </div>
  {{/if}}

  {{!-- === FORM === --}}
  {{#if showForm}}
    <form method="post" action="/reset-password" class="auth-form">
      {{#if token}}
        <input type="hidden" name="token" value="{{token}}" />
      {{/if}}

      <label class="auth-label">
        New password
        <input
          type="password"
          name="password"
          class="auth-input"
          required
          minlength="8"
          autocomplete="new-password"
        />
      </label>

      <button type="submit" class="auth-submit">
        Update password
      </button>
    </form>

    <p class="auth-hint">
      After changing your password, you will be signed out on all devices.
    </p>
  {{/if}}

  {{!-- === CTA when token is invalid / expired === --}}
  {{#unless showForm}}
    <div class="auth-actions">
      <a href="/forgot-password" class="auth-link">
        Request new reset link
      </a>
    </div>
  {{/unless}}

  <div class="auth-actions">
    <a href="/login" class="auth-link">Back to sign in</a>
  </div>
</div>
