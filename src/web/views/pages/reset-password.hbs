{{!-- src/web/views/pages/reset-password.hbs --}}

<section class="auth-shell">
  <section class="auth-card" aria-label="Reset password">
    <nav class="auth-tabs" aria-label="Auth navigation">
      <a class="auth-tab" href="/login">Sign in</a>
      <a class="auth-tab" href="/register">Register</a>
    </nav>

    <h1 class="auth-title">Reset password</h1>

    {{#if errors}}
      <div class="auth-error" role="alert" aria-live="polite">
        <ul>
          {{#each errors}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    {{#if note}}
      <div class="auth-note" role="status" aria-live="polite">
        {{note}}
      </div>
    {{/if}}

    <form class="auth-form" method="post" action="/reset-password" novalidate autocomplete="on">
      <input type="hidden" name="token" value="{{token}}">

      <div class="auth-field">
        <label for="password">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary">
        Update password
      </button>

      <p class="auth-help">
        After changing your password, you will be signed out on all devices.
      </p>

      <p class="auth-help">
        <a href="/login">Back to sign in</a>
      </p>
    </form>
  </section>
</section>
