{{!-- src/views/template.hbs --}}
<section class="template-detail">
  <a href="/" class="back-link">← Back to catalog</a>

  <h1>{{template.title}}</h1>

  <p class="template-meta">
    Category: {{template.category}} · Price: {{template.price}} {{template.currency}}
  </p>

  <p class="template-desc">
    {{template.description}}
  </p>

  {{#if template.demoUrl}}
    <p class="template-demo">
      <a
        class="btn btn-primary"
        href="{{template.demoUrl}}?back=/templates"
        target="_blank"
        rel="noopener"
      >
        👁 Open demo
      </a>
    </p>
  {{/if}}
</section>
