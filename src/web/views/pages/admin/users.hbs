<div class="admin-users">
  <div class="admin-dashboard__header">
    <h1 class="admin-dashboard__title">Users</h1>

    <div class="admin-view-toggle" aria-label="Users trash">
      <a href="/admin/users/trash" class="c-btn c-btn--sm">Trash</a>
    </div>
  </div>

  <form class="admin-filters" method="get" action="/admin/users">
    <div class="admin-filters__row">
      <div class="admin-filters__field">
        <label class="form__label" for="regFrom">Registered from</label>
        <input class="input" type="date" id="regFrom" name="regFrom" value="{{filters.regFrom}}" />
      </div>
      <div class="admin-filters__field">
        <label class="form__label" for="regTo">to</label>
        <input class="input" type="date" id="regTo" name="regTo" value="{{filters.regTo}}" />
      </div>
    </div>

    <div class="admin-filters__row">
      <label class="admin-filters__checkbox">
        <input type="checkbox" name="empty" value="1" {{#if checkboxes.empty}}checked{{/if}} />
        Empty (no rent, no purchase, no sale)
      </label>
      <label class="admin-filters__checkbox">
        <input type="checkbox" name="buyers" value="1" {{#if checkboxes.buyers}}checked{{/if}} />
        Buyers (paid for a rental or a purchase)
      </label>
      <label class="admin-filters__checkbox">
        <input type="checkbox" name="sellers" value="1" {{#if checkboxes.sellers}}checked{{/if}} />
        Sellers (rented out or sold their templates)
      </label>
    </div>

    <div class="admin-filters__actions">
      <button type="submit" class="c-btn c-btn--primary">Apply</button>
      <a class="c-btn" href="/admin/users">Reset</a>
    </div>
  </form>

  <section class="admin-table-card">
    {{#if users.length}}
      <table class="admin-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Registered</th>
            <th>Sold &middot; buy</th>
            <th>Sold &middot; rent</th>
            <th>Bought &middot; buy</th>
            <th>Bought &middot; rent</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
            <tr>
              <td>{{this.displayName}}</td>
              <td>{{this.email}}</td>
              <td>{{this.role}}</td>
              <td>{{this.status}}</td>
              <td>{{this.registeredLabel}}</td>
              <td>{{this.soldBuyCount}}</td>
              <td>{{this.soldRentCount}}</td>
              <td>{{this.boughtBuyCount}}</td>
              <td>{{this.boughtRentCount}}</td>
              <td>
                {{#if (eq this.status "active")}}
                  <form method="post" action="/admin/users/{{this.id}}/delete" class="admin-delete-user-form" data-confirm-email="{{this.email}}">
                    <button type="submit" class="c-btn c-btn--sm c-btn--danger">Delete</button>
                  </form>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <div class="admin-pagination">
        <span class="admin-pagination__summary">{{total}} users &middot; page {{page}} of {{totalPages}}</span>
        <div class="admin-pagination__links">
          {{#if hasPrev}}
            <a class="c-btn" href="{{prevHref}}">Previous</a>
          {{/if}}
          {{#if hasNext}}
            <a class="c-btn" href="{{nextHref}}">Next</a>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="admin-empty-state">
        <h2>No users match these filters</h2>
        <p class="admin-empty-state__hint">Try widening the date range or clearing a checkbox.</p>
      </div>
    {{/if}}
  </section>
</div>

<script>
  (function () {
    document.addEventListener('submit', async function (e) {
      var form = e.target;
      if (!form || !form.classList || !form.classList.contains('admin-delete-user-form')) return;
      if (form.dataset.confirmed === '1') return;
      e.preventDefault();

      var email = form.getAttribute('data-confirm-email') || 'this account';
      var ok = await window.tempasiConfirm({
        title: 'Delete account?',
        message:
          'Delete "' + email + '"? Same as self-deletion — nothing is physically removed, but the account is logged out everywhere, can\'t log back in, and its templates stop showing up publicly. Restore it from Users › Trash if needed.',
        confirmLabel: 'Delete',
        danger: true,
      });

      if (!ok) return;
      form.dataset.confirmed = '1';
      form.submit();
    });
  })();
</script>
