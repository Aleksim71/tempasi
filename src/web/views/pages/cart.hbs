{{!-- src/web/views/pages/cart.hbs --}}
<section class="cart-page">
  <div class="l-container">
    <div class="cart-shell">
      <div class="cart-head">
        <h1 class="cart-title">Cart</h1>
        <p class="cart-subtitle">Selected templates for checkout.</p>
      </div>

      {{#if notice}}
        <div class="cart-notice">{{notice}}</div>
      {{/if}}

      {{#if cart.items.length}}
        <div class="cart-panel">
          <div class="finance-table-wrap">
            <table class="finance-table">
              <thead>
                <tr>
                  <th>Template</th>
                  <th>Type</th>
                  <th>License</th>
                  <th>Added</th>
                  <th>Amount</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each cart.items}}
                  <tr{{#unless isAvailable}} class="cart-row--unavailable"{{/unless}}>
                    <td>
                      {{template_title}}
                      {{#unless isAvailable}}
                        <div class="cart-badge cart-badge--warn">Not available</div>
                      {{/unless}}
                    </td>
                    <td>
                      {{deal_type}}
                      {{#if durationLabel}}
                        <div class="cart-muted">{{durationLabel}}</div>
                      {{/if}}
                    </td>
                    <td>{{license}}</td>
                    <td>{{created_at_str}}</td>
                    <td>€{{amountEur}}</td>
                    <td>
                      <div class="cart-actions">
                        <a class="btn alt" href="{{detailsHref}}">Details</a>
                        <form method="post" action="/cart/remove">
                          <input type="hidden" name="item_id" value="{{id}}" />
                          <button type="submit" class="btn alt">Remove</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <div class="cart-summary">
            <div class="cart-summary__row">
              <span>Items</span>
              <strong>{{cart.itemCount}}</strong>
            </div>
            <div class="cart-summary__row">
              <span>Subtotal</span>
              <strong>€{{cart.subtotalEur}}</strong>
            </div>

            <form method="post" action="/cart/checkout-all" class="cart-summary__checkout" id="cartCheckoutAllForm">
              <button type="submit" class="btn primary">Checkout</button>
            </form>
            <div class="cart-summary__hint">
              Runs the real purchase pipeline for every BUY item in your cart (exclusivity check, payment
              completion, download link) — same code path a real payment webhook would use. RENT items must
              still be checked out individually for now.
            </div>

            <form method="post" action="/cart/demo-checkout" class="cart-summary__checkout" style="margin-top: 8px;">
              <button type="submit" class="btn">Complete demo checkout (legacy, no confirmation)</button>
            </form>
            <div class="cart-summary__hint">
              Demo checkout marks the current cart as paid and is available only outside production.
            </div>
          </div>
        </div>
      {{else}}
        <div class="cart-empty">
          <div class="cart-empty__title">Your cart is empty</div>
          <div class="cart-empty__text">Add templates from the catalog to start checkout.</div>
          <a class="btn primary" href="/templates">Browse templates</a>
        </div>
      {{/if}}
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('cartCheckoutAllForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      if (form.dataset.confirmed === '1') return;
      e.preventDefault();

      var itemCount = {{cart.itemCount}};
      var subtotal = '{{cart.subtotalEur}}';
      var ok = window.confirm(
        'Buy ' + itemCount + ' item(s) for €' + subtotal + '? This completes payment immediately — there is no undo.',
      );

      if (!ok) return;

      form.dataset.confirmed = '1';
      form.submit();
    });
  })();
</script>
