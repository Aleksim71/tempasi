{{!-- TEMPASI_STEP_6F_REAL_UI_SOLD_UNAVAILABLE_BEHAVIOR --}}
{{#if template.isSold}}
<section class="template-availability template-availability--sold" data-testid="template-sold-unavailable">
  <strong>Sold</strong>
  <span>No longer available for BUY or RENT.</span>
</section>
{{/if}}


{{!-- TEMPASI_STEP_6E_BUY_EXCLUSIVITY_UI_ROUTE_CONTRACT
Template details UI contract:
Sold / no longer available templates must not expose active BUY or RENT checkout CTAs.
Keep BUY/RENT controls behind availability state from the catalog/route layer.
--}}

{{!-- src/web/views/pages/template-details.hbs --}}

<section class="tpl-details tpl-details--product-layout">
  {{#if template.isSold}}
    <section class="template-availability template-availability--sold" data-testid="template-sold-unavailable">
      <strong>Sold</strong>
      <span>No longer available for BUY or RENT.</span>
    </section>
  {{/if}}

  <article class="tpl-product-card">
    <div class="tpl-product-card__main">
      <h1 class="tpl-title">{{template.title}}</h1>

      {{#if template.description}}
        <p class="tpl-desc tpl-product-card__desc">{{template.description}}</p>
      {{/if}}

      <div class="tpl-product-card__meta">
        {{#if template.category}}
          <span>{{template.category}}</span>
        {{/if}}

        {{#if template.slug}}
          <span>{{template.slug}}</span>
        {{/if}}

        {{#if template.license}}
          <span>{{template.license}}</span>
        {{/if}}

        {{#if template.type}}
          <span>{{template.type}}</span>
        {{/if}}

        {{#if template.version}}
          <span>v{{template.version}}</span>
        {{/if}}
      </div>
    </div>

    <div class="tpl-product-card__prices">
      <div class="tpl-price-line">
        <span>Buy</span>
        <strong>
          {{#if template.prices.buy}}
            {{template.prices.buy.amount}}{{#if (eq template.prices.buy.currency "EUR")}}€{{else}} {{template.prices.buy.currency}}{{/if}}
          {{else}}
            {{#if template.price}}
              {{template.price}}{{#if (eq template.currency "EUR")}}€{{else}} {{template.currency}}{{/if}}
            {{else}}
              —
            {{/if}}
          {{/if}}
        </strong>
      </div>

      <div class="tpl-price-line">
        <span>Rent</span>
        <strong>
          {{#if template.prices.rent}}
            {{template.prices.rent.amount}}{{#if (eq template.prices.rent.currency "EUR")}}€{{else}} {{template.prices.rent.currency}}{{/if}}
          {{else}}
            —
          {{/if}}
        </strong>
      </div>
    </div>
  </article>

  <div class="tpl-layout">
    <div>
      <div class="tpl-preview">
        <img
          class="tpl-preview__img"
          src="{{#if template.previewUrl}}{{template.previewUrl}}{{else}}/t/{{template.slug}}/preview.png{{/if}}"
          alt="Preview {{template.title}}"
          loading="lazy"
        />
      </div>

      <div class="tpl-underCta">
        {{#if template.longDescription}}
          <div class="tpl-box">
            <div class="tpl-box__title">About this template</div>
            <p class="tpl-desc">{{template.longDescription}}</p>
          </div>
        {{/if}}

        {{#if template.features}}
          <div class="tpl-box">
            <div class="tpl-box__title">Highlights</div>
            <ul class="tpl-list">
              {{#each template.features}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
        {{/if}}
      </div>
    </div>

    <aside class="tpl-side">
      <div class="tpl-box tpl-actions-card">
        <div class="tpl-box__title">Actions</div>

        <div class="tpl-cta">
          <div class="tpl-ctaRow">
            {{#if template.demoUrl}}
              <a class="c-btn c-btn--primary" href="{{template.demoUrl}}" target="_blank" rel="noopener noreferrer">Demo</a>
            {{else}}
              <a class="c-btn c-btn--primary" href="/preview/{{template.slug}}" target="_blank" rel="noopener">Demo</a>
            {{/if}}

            <a class="c-btn" href="/templates">← Back</a>
          </div>

          <div class="tpl-ctaRow">
            {{#if template.isSold}}
              <button type="button" class="c-btn" disabled>Already sold</button>
            {{else}}
              {{#if template.canBuy}}
                <form class="tpl-buyForm" method="POST" action="/cart/add">
                  <input type="hidden" name="template_slug" value="{{template.slug}}" />
                  <input type="hidden" name="deal_type" value="BUY" />
                  <input type="hidden" name="license" value="PU" />
                  <input type="hidden" name="next" value="/templates/{{template.slug}}" />
                  <button type="submit" class="c-btn">Buy</button>
                </form>
              {{else}}
                <button type="button" class="btn btn-disabled" disabled data-testid="buy-sold-disabled">Sold</button>
              {{/if}}

              {{#if template.canRent}}
                {{#if template.prices.rent}}
                  <form class="tpl-buyForm" method="POST" action="/cart/add">
                    <input type="hidden" name="template_slug" value="{{template.slug}}" />
                    <input type="hidden" name="deal_type" value="RENT" />
                    <input type="hidden" name="license" value="PU" />
                    <input type="hidden" name="next" value="/templates/{{template.slug}}" />
                    <button type="submit" class="c-btn">Rent</button>
                  </form>
                {{/if}}
              {{else}}
                <button type="button" class="btn btn-disabled" disabled data-testid="rent-sold-disabled">Rent unavailable</button>
              {{/if}}
            {{/if}}
          </div>

          <div class="tpl-hint">
            Secure checkout · buying is one-time and exclusive.
            <br />
            Renting reserves the template for a client presentation.
          </div>
        </div>
      </div>

      <div class="tpl-box tpl-seller-card">
        <div class="tpl-box__title">Created by</div>

        {{#if template.author}}
          {{#if template.author.name}}
            <div class="tpl-seller-card__name"><strong>{{template.author.name}}</strong></div>
          {{/if}}

          {{#if template.author.nickname}}
            <div class="tpl-note">@{{template.author.nickname}}</div>
          {{/if}}

          {{#if template.author.bio}}
            <div class="tpl-note">{{template.author.bio}}</div>
          {{/if}}

          {{#if template.author.public_email}}
            <div class="tpl-note">
              Contact: <a href="mailto:{{template.author.public_email}}">{{template.author.public_email}}</a>
            </div>
          {{/if}}
        {{else}}
          <div class="tpl-muted">Seller profile is not public yet.</div>
        {{/if}}
      </div>
    </aside>
  </div>
</section>
