{{!-- src/web/views/pages/template-details.hbs --}}

<section class="tpl-details">
  <div class="tpl-head">
    <div class="tpl-head__left">
      <h1 class="tpl-title">{{template.title}}</h1>

      <div class="tpl-meta">
        {{#if template.isSold}}
          <span class="badge badge--sold">SOLD</span>
        {{/if}}
        {{#if template.category}}
          <span class="tpl-muted">{{template.category}}</span>
        {{/if}}

        {{#if template.license}}
          <span class="tpl-muted">· {{template.license}}</span>
        {{/if}}

        {{#if template.type}}
          <span class="tpl-muted">· {{template.type}}</span>
        {{/if}}

        {{#if template.version}}
          <span class="tpl-muted">· v{{template.version}}</span>
        {{/if}}
      </div>

      {{#if template.description}}
        <p class="tpl-desc">{{template.description}}</p>
      {{/if}}
    </div>

    <div class="tpl-head__right">
      <div class="tpl-price">
        {{#if template.prices.buy}}
          Buy: {{template.prices.buy.amount}}{{#if (eq template.prices.buy.currency "EUR")}}€{{else}} {{template.prices.buy.currency}}{{/if}}
        {{else}}
          {{#if template.price}}
            Buy: {{template.price}}{{#if (eq template.currency "EUR")}}€{{else}} {{template.currency}}{{/if}}
          {{else}}
            —
          {{/if}}
        {{/if}}
      </div>

      <div class="tpl-cta">
        <div class="tpl-ctaRow">
          {{#if template.demoUrl}}
            <a class="c-btn c-btn--primary" href="{{template.demoUrl}}" target="_blank" rel="noopener noreferrer">
              Demo
            </a>
          {{else}}
            <a class="c-btn c-btn--primary" href="/preview/{{template.slug}}" target="_blank" rel="noopener">
              Demo
            </a>
          {{/if}}

          <a class="c-btn" href="/templates">← Back</a>
        </div>

        <div class="tpl-ctaRow">
          {{!-- BUY --}}
          {{#if template.isSold}}
            <button type="button" class="c-btn" disabled>Already sold</button>
          {{else}}
            <form class="tpl-buyForm" method="POST" action="/api/orders/{{template.slug}}/buy">
              <input type="hidden" name="dealType" value="BUY" />
              {{#if template.prices.buy}}
                <input type="hidden" name="amount" value="{{template.prices.buy.amount}}" />
                <input type="hidden" name="currency" value="{{template.prices.buy.currency}}" />
              {{else}}
                <input type="hidden" name="amount" value="{{template.price}}" />
                <input type="hidden" name="currency" value="EUR" />
              {{/if}}
              <button type="submit" class="c-btn">Buy</button>
            </form>

            <form class="tpl-buyForm" method="POST" action="/cart/add">
              <input type="hidden" name="template_slug" value="{{template.slug}}" />
              <input type="hidden" name="deal_type" value="BUY" />
              <input type="hidden" name="license" value="PU" />
              <input type="hidden" name="next" value="/templates/{{template.slug}}" />
              <button type="submit" class="c-btn">Add to cart</button>
            </form>
          {{/if}}

          {{!-- RENT: add reservation to cart, then checkout/payment completes the 24h hold --}}
          {{#if template.prices.rent}}
            <form class="tpl-buyForm" method="POST" action="/cart/add">
              <input type="hidden" name="template_slug" value="{{template.slug}}" />
              <input type="hidden" name="deal_type" value="RENT" />
              <input type="hidden" name="license" value="PU" />
              <input type="hidden" name="next" value="/templates/{{template.slug}}" />
              <button type="submit" class="c-btn">Add rent to cart</button>
            </form>
          {{/if}}

          {{!-- Download (если zip готов) --}}
          {{#if template.hasZip}}
            <a class="c-btn" href="/downloads/{{template.slug}}">Download</a>
          {{/if}}
        </div>

        <div class="tpl-hint">
          Secure checkout · instant access after purchase
          <br />
          Buying is one-time and exclusive, regardless of how many cases use this template.
        </div>
      </div>
    </div>
  </div>

  <div class="tpl-layout">
    <div>
      <div class="tpl-preview">
        <img
          class="tpl-preview__img"
          src="{{#if template.previewUrl}}{{template.previewUrl}}{{else}}/t/{{template.slug}}/preview.png{{/if}}"
          alt="Preview {{template.title}}"
          loading="lazy"
        />
      </div>

      <div class="tpl-underCta">
        {{#if template.longDescription}}
          <div class="tpl-box">
            <div class="tpl-box__title">About this template</div>
            <p class="tpl-desc">{{template.longDescription}}</p>
          </div>
        {{/if}}
      </div>
    </div>

    <aside class="tpl-side">
      <div class="tpl-box">
        <div class="tpl-box__title">Template info</div>

        <dl class="tpl-dl">
          <div class="tpl-dl__row">
            <dt>Slug</dt>
            <dd>{{template.slug}}</dd>
          </div>

          {{#if template.tech}}
            <div class="tpl-dl__row">
              <dt>Tech</dt>
              <dd>
                {{#each template.tech}}
                  <span class="tpl-muted">{{this}}</span>{{#unless @last}}, {{/unless}}
                {{/each}}
              </dd>
            </div>
          {{/if}}

          {{#if template.updatedAt}}
            <div class="tpl-dl__row">
              <dt>Updated</dt>
              <dd>{{template.updatedAt}}</dd>
            </div>
          {{/if}}

          <div class="tpl-dl__row">
            <dt>ZIP</dt>
            <dd>{{#if template.hasZip}}Ready{{else}}Not ready{{/if}}</dd>
          </div>
        </dl>

        {{#if template.features}}
          <div class="tpl-note">Highlights</div>
          <ul class="tpl-list">
            {{#each template.features}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </div>

      <div class="tpl-box">
        <div class="tpl-box__title">Author</div>

        {{#if template.author}}
          {{#if template.author.name}}
            <div><strong>{{template.author.name}}</strong></div>
          {{/if}}
          {{#if template.author.bio}}
            <div class="tpl-note">{{template.author.bio}}</div>
          {{/if}}
          {{#if template.author.url}}
            <div class="tpl-note">
              <a class="c-btn" href="{{template.author.url}}" target="_blank" rel="noopener">Profile</a>
            </div>
          {{/if}}
        {{else}}
          <div class="tpl-muted">—</div>
        {{/if}}
      </div>
    </aside>
  </div>
</section>
