{{!-- src/web/views/pages/template-details.hbs --}}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{title}}</title>

    <!-- Core -->
    <link rel="stylesheet" href="/css/core.css" />
    <link rel="stylesheet" href="/css/layout.css" />

    <!-- Components -->
    <link rel="stylesheet" href="/css/components/button.css" />
    <link rel="stylesheet" href="/css/components/card.css" />
    <link rel="stylesheet" href="/css/components/header.css" />
    <link rel="stylesheet" href="/css/components/badge.css" />

    <!-- Page -->
    <link rel="stylesheet" href="/css/pages/template-details.css" />

    <!-- Global core -->
    <script defer src="/js/core.js"></script>
  </head>

  <body class="{{bodyClass}}">


    <main class="l-page">
      <div class="l-main">
        <div class="l-container l-stack">

          <section class="tpl-details">
            <div class="tpl-details__grid">
              <div class="tpl-details__left">
                <div class="tpl-details__preview">
                  <img class="tpl-details__img" src="{{template.preview}}" alt="{{template.title}}" loading="lazy" />
                </div>
              </div>

              <div class="tpl-details__right">
                <h1 class="tpl-details__title">{{template.title}}</h1>

                <div class="tpl-details__meta">
                  {{#if template.category}}
                    <span class="badge badge--muted">{{template.category}}</span>
                  {{/if}}
                  {{#if template.license}}
                    <span class="badge badge--pill">{{template.license}}</span>
                  {{/if}}
                  {{#if template.type}}
                    <span class="badge badge--muted">{{template.type}}</span>
                  {{/if}}
                  {{#if template.version}}
                    <span class="badge badge--muted">v{{template.version}}</span>
                  {{/if}}
                  {{#if template.hasZip}}
                    <span class="badge badge--ok">ZIP ready</span>
                  {{else}}
                    <span class="badge badge--muted">ZIP not ready</span>
                  {{/if}}
                </div>

                {{#if template.description}}
                  <p class="tpl-details__desc">{{template.description}}</p>
                {{/if}}

                <div class="tpl-details__price">
                  <div class="tpl-details__price-label">Price</div>
                  <div class="tpl-details__price-value">{{formatPrice template.price}}</div>
                </div>

                <div class="tpl-details__actions">
                  <a class="c-btn c-btn--primary" href="/preview/{{template.slug}}">Open live preview</a>

                  {{#if (isFree template.price)}}
                    {{#if template.hasZip}}
                      <a class="c-btn" href="/download/{{template.slug}}">Download</a>
                    {{/if}}
                  {{else}}
                    <form method="POST" action="/api/orders/{{template.slug}}/buy" style="margin:0;">
                      <input type="hidden" name="dealType" value="BUY" />
                      <input type="hidden" name="amount" value="{{template.price}}" />
                      <input type="hidden" name="currency" value="EUR" />
                      <button type="submit" class="c-btn">Buy</button>
                    </form>

                    {{#if template.hasZip}}
                      <a class="c-btn" href="/download/{{template.slug}}">Download</a>
                    {{/if}}
                  {{/if}}

                  <a class="c-btn" href="/templates">← Back to catalog</a>
                </div>
              </div>
            </div>
          </section>

        </div>
      </div>
    </main>
  </body>
</html>
