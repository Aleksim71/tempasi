{{!-- src/web/views/pages/template-details.hbs --}}

<section class="template-details-page template-product-page">
  <div class="template-details-shell">

    <main class="template-details-main">
      <header class="template-product-hero">
        <div>
          <p class="template-eyebrow">Template</p>
          <h1>{{template.title}}</h1>

          {{#if template.description}}
            <p class="template-lead">{{template.description}}</p>
          {{else}}
            <p class="template-lead">Exclusive web template for client presentation, rent, or purchase.</p>
          {{/if}}

          <div class="template-meta-row">
            {{#if template.dealType}}
              <span class="template-meta-pill">Available: {{template.dealType}}</span>
            {{else}}
              <span class="template-meta-pill">Available</span>
            {{/if}}

            {{#if template.category}}
              <span class="template-meta-pill">Category: {{template.category}}</span>
            {{else}}
              <span class="template-meta-pill">Category: Template</span>
            {{/if}}

            <span class="template-meta-pill">Rating: coming soon</span>

            {{#if template.slug}}
              <span class="template-meta-pill template-meta-muted">{{template.slug}}</span>
            {{/if}}
          </div>
        </div>
      </header>

      <article class="template-preview-card">
        {{#if template.previewUrl}}
          <img src="{{template.previewUrl}}" alt="{{template.title}} preview" class="template-preview-image">
        {{else}}
          <div class="template-preview-placeholder">Preview not available</div>
        {{/if}}
      </article>

      <section class="template-info-card">
        <p class="template-eyebrow">Overview</p>
        <h2>About this template</h2>

        {{#if template.shortDescription}}
          <p>{{template.shortDescription}}</p>
        {{else if template.description}}
          <p>{{template.description}}</p>
        {{else}}
          <p>This template is prepared for Tempasi marketplace preview, client presentation, rent, and exclusive purchase.</p>
        {{/if}}
      </section>

      <section class="template-info-card">
        <p class="template-eyebrow">Author content</p>
        <h2>Details from the author</h2>

        {{#if template.fullDescription}}
          <p>{{template.fullDescription}}</p>
        {{else if template.about}}
          <p>{{template.about}}</p>
        {{else}}
          <p>The author has not added a full description yet.</p>
        {{/if}}
      </section>
    </main>

    <aside class="template-actions-sidebar">
      {{#if isOwner}}
        <section class="template-action-card">
          <p class="template-eyebrow">Owner actions</p>
          <h2>Your template</h2>
          <p class="template-action-note">Commercial buy and rent actions are disabled for your own templates.</p>

          <div class="template-action-stack">
            <a class="btn btn-primary" href="/cabinet/my-templates/{{template.id}}/edit">Edit template</a>

            <form method="post" action="/templates/{{template.slug}}/owner/reserve" class="template-inline-form">
              <label class="template-field-label" for="owner_hold_days">Reserve for client</label>
              <input id="owner_hold_days" name="days" type="number" min="1" max="30" value="1" class="template-days-input">
              <button class="btn btn-secondary" type="submit">Reserve for client</button>
            </form>

            <form method="post" action="/templates/{{template.slug}}/owner/withdraw">
              <button class="btn btn-danger" type="submit">Withdraw permanently</button>
            </form>

            {{#if template.demoUrl}}
              <a class="btn btn-secondary" href="{{template.demoUrl}}" target="_blank" rel="noopener">Demo</a>
            {{else}}
              <a class="btn btn-secondary" href="/preview/{{template.slug}}" target="_blank" rel="noopener">Demo</a>
            {{/if}}
          </div>
        </section>
      {{else}}
        <section class="template-action-card template-buy-card">
          <p class="template-eyebrow">Buy</p>
          <div class="template-price-row">
            <h2>Exclusive purchase</h2>
            {{#if template.prices.buy.amount}}
              <strong>{{template.prices.buy.amount}}€</strong>
            {{else if template.price}}
              <strong>{{template.price}}€</strong>
            {{else}}
              <strong>—</strong>
            {{/if}}
          </div>

          <p class="template-action-note">Buy once and remove this template from public sale and rent permanently.</p>

          <div class="template-action-stack">
            {{#if isAuthenticated}}
              <form method="post" action="/cart/add">
                <input type="hidden" name="template_slug" value="{{template.slug}}">
                <input type="hidden" name="deal_type" value="BUY">
                <input type="hidden" name="license" value="BUY">
                <input type="hidden" name="next" value="/cart">
                <button class="btn btn-primary" type="submit">Buy now</button>
              </form>

              <form method="post" action="/cart/add">
                <input type="hidden" name="template_slug" value="{{template.slug}}">
                <input type="hidden" name="deal_type" value="BUY">
                <input type="hidden" name="license" value="BUY">
                <button class="btn btn-secondary" type="submit">Add to cart</button>
              </form>
            {{else}}
              <a class="btn btn-primary" href="/login">Buy now</a>
              <a class="btn btn-secondary" href="/login">Add to cart</a>
              <p class="template-login-note">Sign in or create an account to buy, rent, or save templates to your cases.</p>
            {{/if}}
          </div>
        </section>

        <section class="template-action-card template-rent-card">
          <p class="template-eyebrow">Rent</p>
          <div class="template-price-row">
            <h2>Client reservation</h2>
            {{#if template.prices.rent.amount}}
              <strong>{{template.prices.rent.amount}}€ / day</strong>
            {{else}}
              <strong>—</strong>
            {{/if}}
          </div>

          <p class="template-action-note">Reserve this template for selected days with exclusive right to buy during active rent.</p>

          {{#if isAuthenticated}}
            <form method="post" action="/cart/add" class="template-rent-form">
              <input type="hidden" name="template_slug" value="{{template.slug}}">
              <input type="hidden" name="deal_type" value="RENT">
              <input type="hidden" name="license" value="PU">

              <label class="template-field-label" for="rent_days">Days</label>
              <input id="rent_days" name="rent_days" type="number" min="1" max="30" value="1" class="template-days-input">

              <div class="template-cases-box">
                <p class="template-field-label">Cases</p>

                {{#if cases.length}}
                  {{#each cases}}
                    <label class="template-checkbox-row">
                      <input type="checkbox" name="case_ids" value="{{this.id}}">
                      <span>{{this.title}}</span>
                    </label>
                  {{/each}}
                {{else}}
                  <p class="template-empty-note">No cases yet. You can create a case in Cabinet.</p>
                {{/if}}
              </div>

              <button class="btn btn-primary" type="submit" name="next" value="/cart">Rent now</button>
              <button class="btn btn-secondary" type="submit">Add rent to cart</button>
            </form>

            {{#if template.demoUrl}}
              <a class="btn btn-secondary" href="{{template.demoUrl}}" target="_blank" rel="noopener">Demo</a>
            {{else}}
              <a class="btn btn-secondary" href="/preview/{{template.slug}}" target="_blank" rel="noopener">Demo</a>
            {{/if}}
          {{else}}
            <div class="template-rent-form template-rent-form-disabled">
              <label class="template-field-label" for="guest_rent_days">Days</label>
              <input
                id="guest_rent_days"
                name="rent_days"
                type="number"
                min="1"
                max="30"
                value="1"
                class="template-days-input"
                disabled
              >

              <div class="template-cases-box">
                <p class="template-field-label">Cases</p>
                <label class="template-checkbox-row template-checkbox-disabled">
                  <input type="checkbox" name="case_ids" value="" disabled>
                  <span>Sign in to select one or more cases</span>
                </label>
              </div>

              <a class="btn btn-primary" href="/login">Rent now</a>
              <a class="btn btn-secondary" href="/login">Add rent to cart</a>

              {{#if template.demoUrl}}
                <a class="btn btn-secondary" href="{{template.demoUrl}}" target="_blank" rel="noopener">Demo</a>
              {{else}}
                <a class="btn btn-secondary" href="/preview/{{template.slug}}" target="_blank" rel="noopener">Demo</a>
              {{/if}}

              <p class="template-login-note">Sign in or create an account to rent this template or attach it to cases.</p>
            </div>
          {{/if}}
        </section>
      {{/if}}

      <section class="template-action-card template-author-card">
        <p class="template-eyebrow">Created by</p>

        {{#if sellerProfile}}
          {{#if sellerProfile.full_name}}
            <h2>{{sellerProfile.full_name}}</h2>
          {{else}}
            <h2>Tempasi seller</h2>
          {{/if}}

          {{#if sellerProfile.nickname}}
            <p class="template-author-handle">@{{sellerProfile.nickname}}</p>
          {{else if sellerProfile.username}}
            <p class="template-author-handle">@{{sellerProfile.username}}</p>
          {{/if}}

          {{#if sellerProfile.about}}
            <p>{{sellerProfile.about}}</p>
          {{else}}
            <p>Seller profile is not public yet.</p>
          {{/if}}

          {{#if sellerProfile.public_email}}
            <p class="template-author-contact">Contact: {{sellerProfile.public_email}}</p>
          {{/if}}
        {{else}}
          <h2>Tempasi seller</h2>
          <p>Seller profile is not public yet.</p>
        {{/if}}
      </section>
    </aside>
  </div>
</section>
