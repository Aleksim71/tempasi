{{!-- src/web/views/pages/cabinet/cases/new.hbs --}}
<link rel="stylesheet" href="/css/pages/cabinet-cases.css" />

<section class="cabinet-cases" data-page="cabinet-cases-new">
  <header class="cabinet-cases__header">
    <div class="cabinet-cases__title">
      <h1>Create case</h1>
      <p class="muted">Name it like: “Müller GmbH (redesign)”.</p>
    </div>
  </header>

  {{#if error}}
    <div class="alert alert--danger">{{error}}</div>
  {{/if}}

  <form class="form" method="post" action="/cabinet/cases">
    <label class="field">
      <div class="field__label">Case name</div>
      <input class="input" name="title" required maxlength="160" value="{{form.title}}" placeholder="Müller GmbH (redesign)" />
    </label>

    <label class="field">
      <div class="field__label">Notes (optional)</div>
      <textarea class="textarea" name="notes" rows="5" maxlength="4000" placeholder="Internal notes for you (not shown to the client).">{{form.notes}}</textarea>
    </label>

    <div class="form__actions">
      <button class="btn" type="submit">Create</button>
      <a class="btn btn--ghost" href="/cabinet/cases">Cancel</a>
    </div>
  </form>
</section>
