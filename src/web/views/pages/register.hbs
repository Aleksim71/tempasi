{{!-- src/web/views/pages/register.hbs --}}

<main class="auth-page">
  <div class="auth-wrap">
    <section class="auth-card" aria-labelledby="auth-title">
      <header class="auth-head">
        <div class="auth-switch" id="auth-title" aria-label="Auth mode">
          <a class="auth-switch__link" href="/login">Sign in</a>
          <span class="auth-switch__sep" aria-hidden="true"></span>
          <a class="auth-switch__link is-active" href="/register" aria-current="page">Register</a>
        </div>
      </header>

      {{#if error}}
        <div class="auth-alert" role="alert">{{error}}</div>
      {{/if}}

      <form class="auth-form" method="post" action="/register" novalidate>
        <div class="auth-field">
          <label class="auth-label" for="email">Email</label>
          <input
            class="auth-input"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            value="{{form.email}}"
            required
          />
          <p class="auth-hint">We’ll send a confirmation later (MVP: no email).</p>
        </div>

        <div class="auth-field">
          <label class="auth-label" for="password">Password</label>
          <div class="auth-password">
            <input
              class="auth-input"
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              placeholder="••••••••"
              required
            />
            <button class="auth-eye" type="button" aria-label="Show password" title="Show password">
              👁
            </button>
          </div>
          <p class="auth-hint">At least 6 characters.</p>
        </div>

        <div class="auth-row">
          <span style="opacity:.75; font-size:13px;">Already have an account?</span>
          <a href="/login" class="auth-link">Sign in</a>
        </div>

        <div class="auth-actions">
          <button class="auth-btn" type="submit">Create account</button>
        </div>
      </form>
    </section>
  </div>
</main>

<script>
  // minimal client helper (optional): toggle password visibility
  (() => {
    const eye = document.querySelector('.auth-eye');
    const input = document.querySelector('#password');
    if (!eye || !input) return;

    eye.addEventListener('click', () => {
      const next = input.type === 'password' ? 'text' : 'password';
      input.type = next;
      eye.setAttribute('aria-label', next === 'text' ? 'Hide password' : 'Show password');
    });
  })();
</script>
