{{!-- src/web/views/pages/register.hbs --}}

<section class="auth-shell">
  <section class="auth-card" aria-label="Register">
    <nav class="auth-tabs" aria-label="Auth navigation">
      <a class="auth-tab" href="/login{{#if next}}?next={{next}}{{/if}}">Sign in</a>
      <a class="auth-tab is-active" href="/register{{#if next}}?next={{next}}{{/if}}">Register</a>
    </nav>

    {{#if errors}}
      <div class="auth-error" role="alert" aria-live="polite">
        <ul>
          {{#each errors}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <form class="auth-form" method="post" action="/register" novalidate>
      {{#if next}}
        <input type="hidden" name="next" value="{{next}}">
      {{/if}}

      <div class="auth-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required value="{{email}}">
      </div>

      <div class="auth-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required>
      </div>

      <div class="auth-field">
        <label for="password2">Repeat password</label>
        <input id="password2" name="password2" type="password" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn-primary">Create account</button>

      <p class="auth-hint">
        Creating an account signs you in with one strictly necessary session
        cookie. No tracking. How we handle your data:
        <a href="/privacy">Privacy</a> · <a href="/cookies">Cookies</a>
      </p>
    </form>
  </section>
</section>
