{{!-- src/web/views/pages/template-demo.hbs --}}
<section class="template-demo-page" data-template-demo-page>
  <header class="template-demo-toolbar">
    <div class="template-demo-brand">
      <a class="template-demo-back" href="{{demoBackUrl}}" data-smart-demo-back>← Back</a>
      <div>
        <p class="template-demo-eyebrow">Live demo</p>
        <h1>{{template.title}}</h1>
      </div>
    </div>

    <div class="template-demo-toolbar-actions">
      <div class="template-demo-control-group" aria-label="Preview device size">
        <button class="template-demo-choice is-active" type="button" data-demo-device="desktop"><span></span>Desktop</button>
        <button class="template-demo-choice" type="button" data-demo-device="tablet"><span></span>Tablet</button>
        <button class="template-demo-choice" type="button" data-demo-device="mobile"><span></span>Mobile</button>
      </div>

      <div class="template-demo-control-group" aria-label="Demo background theme">
        <button class="template-demo-choice is-active" type="button" data-demo-theme="light"><span></span>Light</button>
        <button class="template-demo-choice" type="button" data-demo-theme="dark"><span></span>Dark</button>
      </div>

      <a class="template-demo-action template-demo-action--buy" href="{{templateDetailsUrl}}?intent=buy">Buy</a>
      <a class="template-demo-action template-demo-action--rent" href="{{templateDetailsUrl}}?intent=rent">Rent</a>
    </div>
  </header>

  <main class="template-demo-stage" data-demo-stage data-demo-theme-current="light">
    <div class="template-demo-browser" data-demo-browser>
      <div class="template-demo-browser-bar">
        <span class="template-demo-dot"></span>
        <span class="template-demo-dot"></span>
        <span class="template-demo-dot"></span>
        <span class="template-demo-url">tempasi.demo / {{template.slug}}</span>
      </div>

      <iframe
        class="template-demo-frame"
        src="{{demoFrameUrl}}"
        title="{{template.title}} live demo"
        loading="eager"
        referrerpolicy="no-referrer"
        {{!--
          TEMPASI_DEMO_SANDBOX_KEEP_ALLOW_SAME_ORIGIN (2026-08-04)
          DevTools warns that allow-scripts + allow-same-origin
          together can let a sandboxed frame escape its sandbox.
          Tried removing allow-same-origin — it broke the demo for
          real: seed templates load main.js as an ES module
          (<script type="module" src="./main.js">), and a sandboxed
          frame WITHOUT allow-same-origin gets an opaque ('null')
          origin, which makes the browser apply CORS to that module
          script load — blocked, since the static file server sends
          no CORS headers. The redirect stub some seed templates use
          (location.replace('./src/')) also broke under the opaque
          origin ("Domains, protocols and ports must match"). Both
          failures were confirmed live, not theoretical. Reverted.
          If this needs revisiting, the real fix is CORS headers on
          the demo server's static responses (Access-Control-Allow-
          Origin: null) plus testing every seed template — not just
          dropping the flag.
        --}}
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
      ></iframe>
    </div>
  </main>

  <script>
    (() => {
      const browser = document.querySelector('[data-demo-browser]');
      const stage = document.querySelector('[data-demo-stage]');
      const buttons = Array.from(document.querySelectorAll('[data-demo-device]'));
      const themeButtons = Array.from(document.querySelectorAll('[data-demo-theme]'));

      if (browser && buttons.length) {
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const device = button.getAttribute('data-demo-device') || 'desktop';

            browser.setAttribute('data-device', device);
            buttons.forEach((item) => item.classList.toggle('is-active', item === button));
          });
        });
      }

      if (stage && themeButtons.length) {
        themeButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const theme = button.getAttribute('data-demo-theme') || 'light';

            stage.setAttribute('data-demo-theme-current', theme);
            themeButtons.forEach((item) => item.classList.toggle('is-active', item === button));
          });
        });
      }
    })();
  </script>
</section>

<script>
  (() => {
    const backLink = document.querySelector('[data-smart-demo-back]');
    if (!backLink) return;

    backLink.addEventListener('click', (event) => {
      const referrer = document.referrer || '';
      const currentOrigin = window.location.origin;

      if (window.history.length > 1 && referrer.startsWith(currentOrigin)) {
        event.preventDefault();
        window.history.back();
      }
    });
  })();
</script>

