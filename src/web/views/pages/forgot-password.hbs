{{!-- src/web/views/pages/forgot-password.hbs --}}

<section class="auth-shell">
  <section class="auth-card" aria-label="Forgot password">
    <nav class="auth-tabs" aria-label="Auth navigation">
      <a class="auth-tab" href="/login">Sign in</a>
      <a class="auth-tab" href="/register">Register</a>
    </nav>

    <h1 class="auth-title">Forgot password</h1>

    {{#if note}}
      <div class="auth-note" role="status" aria-live="polite">
        {{note}}
      </div>
    {{/if}}

    {{#if errors}}
      <div class="auth-error" role="alert" aria-live="polite">
        <ul>
          {{#each errors}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <form class="auth-form" method="post" action="/forgot-password" novalidate autocomplete="on">
      <div class="auth-field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          inputmode="email"
          autocapitalize="none"
          spellcheck="false"
          required
          {{#if email}}value="{{email}}"{{/if}}
        >
      </div>

      <button type="submit" class="btn btn-primary">
        Send reset link
      </button>

      <p class="auth-help">
        We’ll send you a link to reset your password.
        If the email exists, you’ll receive it shortly.
      </p>

      <p class="auth-help">
        <a href="/login">Back to sign in</a>
      </p>
    </form>
  </section>
</section>
