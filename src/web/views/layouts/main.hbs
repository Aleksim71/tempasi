{{!-- src/web/views/layouts/main.hbs --}}
<!doctype html>
<html lang="en">
  <head>
    {{> head}}

    {{!-- Core layout --}}
    <link rel="stylesheet" href="/css/layout.css" />

    {{!-- Components (global) --}}
    <link rel="stylesheet" href="/css/components/button.css" />
    <link rel="stylesheet" href="/css/components/card.css" />
    <link rel="stylesheet" href="/css/components/header.css" />
    <link rel="stylesheet" href="/css/components/badge.css" />
    <link rel="stylesheet" href="/css/components/chips.css" />
    <link rel="stylesheet" href="/css/components/sidebar.css" />

    {{!-- Page-specific styles --}}
    {{#if styles}}
      {{#each styles}}
        <link rel="stylesheet" href="{{this}}" />
      {{/each}}
    {{/if}}
  </head>

  <body class="{{bodyClass}}">
    {{!-- SVG sprite: MUST be inside BODY --}}
    {{> icons-sprite}}

    {{!-- GLOBAL HEADER (can be disabled per page) --}}
    {{#unless hideHeader}}
      {{> site-header}}
    {{/unless}}

    <main class="l-page">
      <div class="l-main">
        {{!-- Cabinet should be wide (Templates-like): do NOT wrap with l-container --}}
        {{#if isCabinet}}
          {{{body}}}
        {{else}}
          <div class="l-container l-stack">
            {{{body}}}
          </div>
        {{/if}}
      </div>
    </main>

    {{!-- GLOBAL FOOTER (can be disabled per page) --}}
    {{#unless hideFooter}}
      {{> footer}}
    {{/unless}}

    {{!-- core JS (safe, page-aware) --}}
    <script defer src="/js/core.js"></script>
  </body>
</html>
