<!doctype html>
<html lang="en">
  <head>
    {{> head}}

    {{!-- page-specific styles --}}
    {{#if styles}}
      {{#each styles}}
        <link rel="stylesheet" href="{{this}}" />
      {{/each}}
    {{/if}}
  </head>

  <body class="{{bodyClass}}">
    {{!-- ✅ SVG sprite must be inside BODY (not between head and body) --}}
    {{> icons-sprite}}

    {{!-- GLOBAL HEADER (can be disabled per page) --}}
    {{#unless hideHeader}}
      {{> site-header}}
    {{/unless}}

    <main class="l-page">
      <div class="l-main">
        <div class="l-container l-stack">
          {{> (lookup . "bodyPartial")}}
        </div>
      </div>
    </main>

    {{!-- core JS (safe, page-aware) --}}
    <script defer src="/js/core.js"></script>
  </body>
</html>
