{{!-- src/views/register.hbs --}}
<section class="auth-page">
  <div class="auth-wrap">
    <div class="auth">

      <form id="registerForm" class="body" action="/register" method="POST" novalidate>
        <div class="row">
          <div class="label">Полное имя</div>
          <div class="input">
            <svg class="icon"><use href="/icons/icons.svg#i-user" /></svg>
            <input
              type="text"
              name="fullName"
              id="fullName"
              placeholder="Ваше имя"
              required
            />
          </div>
        </div>

        <div class="row">
          <div class="label">Email</div>
          <div class="input">
            <svg class="icon"><use href="/icons/icons.svg#i-mail" /></svg>
            <input
              type="email"
              name="email"
              id="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>
          <div class="error" id="emailErr">Введите корректный email</div>
        </div>

        <div class="row">
          <div class="label">Пароль</div>
          <div class="input">
            <svg class="icon"><use href="/icons/icons.svg#i-lock" /></svg>
            <input
              type="password"
              name="password"
              id="password"
              placeholder="••••••••"
              minlength="6"
              autocomplete="new-password"
              required
            />
            <button
              type="button"
              class="toggle-pass"
              id="togglePass"
              aria-label="Показать/скрыть пароль"
            >
              <svg class="icon" id="eye"><use href="/icons/icons.svg#i-eye" /></svg>
            </button>
          </div>
          <div class="hint">Минимум 6 символов</div>
          <div class="error" id="passErr">Пароль слишком короткий</div>
        </div>

        <div class="row">
          <div class="label">Повторите пароль</div>
          <div class="input">
            <svg class="icon"><use href="/icons/icons.svg#i-lock" /></svg>
            <input
              type="password"
              name="passwordConfirm"
              id="passwordConfirm"
              placeholder="••••••••"
              minlength="6"
              autocomplete="new-password"
              required
            />
          </div>
          <div class="error" id="confirmErr">Пароли не совпадают</div>
        </div>

        <label class="remember">
          <input type="checkbox" id="terms" required />
          <span>Я принимаю условия сервиса</span>
        </label>

        <div class="actions">
          <button class="btn primary" id="registerBtn" type="submit">Зарегистрироваться</button>

          <div class="hint">
            Уже есть аккаунт?
            <a href="/login">Войти</a>
          </div>
        </div>
      </form>

    </div>
  </div>
</section>
