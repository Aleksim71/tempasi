<main class="page">
  <div class="profile-layout">

    <!-- ЛЕВОЕ МЕНЮ -->
    <aside class="profile-menu">
      <a class="menu-item is-active">Профиль</a>
      <a class="menu-item">Мои избранные</a>
      <a class="menu-item">Мои аренды</a>
      <a class="menu-item">Billing</a>
      <a class="menu-item">Сделки</a>
    </aside>

    <!-- ПРАВАЯ КОЛОНКА — Основные данные + Публичный профиль -->
    <section class="profile-content">

      <!-- ОСНОВНЫЕ ДАННЫЕ -->
      <div class="profile-section card">
        <h2 class="section-title">Основные данные</h2>

        <form class="profile-form">
          <div class="form-row">
            <label>Полное имя</label>
            <input type="text" placeholder="Ваше имя" />
          </div>

          <div class="form-row">
            <label>Никнейм</label>
            <input type="text" placeholder="Ваш никнейм" />
          </div>

          <div class="form-row">
            <label>Email</label>
            <input type="email" placeholder="you@example.com" />
          </div>

          <div class="form-row">
            <label>Роль</label>
            <input type="text" placeholder="Дизайнер, студия, агентство..." />
          </div>

          <div class="form-row">
            <label>Кратко о себе</label>
            <textarea placeholder="Пара предложений о том, чем вы занимаетесь."></textarea>
          </div>

          <div class="form-actions">
            <button type="button" class="btn alt">Отменить</button>
            <button type="submit" class="btn primary">Сохранить</button>
          </div>
        </form>
      </div>

      <!-- ПУБЛИЧНЫЙ ПРОФИЛЬ -->
      <div class="profile-section card">
        <h2 class="section-title">Публичный профиль</h2>

        <form class="profile-form">
          <div class="form-row">
            <label>Сайт или портфолио</label>
            <input type="text" placeholder="https://dribbble.com/username" />
          </div>

          <div class="form-row">
            <label>Социальные сети</label>
            <input type="text" placeholder="@behance, @instagram, @twitter" />
          </div>

          <div class="form-row">
            <label>Биография</label>
            <textarea placeholder="Расскажите немного о себе для страницы автора."></textarea>
          </div>
        </form>
      </div>

    </section>
  </div>
</main>
