<section class="page page--template-not-found">
  <div class="container tpl-layout">

    {{> sidebar-filters}}

    <main class="tpl-main tpl-main--details">
      <div class="tpl-not-found">
        <h1 class="tpl-not-found__title">Шаблон не найден</h1>
        <p class="tpl-not-found__text">
          К сожалению, шаблона с ID <strong>{{id}}</strong> не существует
          или он временно недоступен.
        </p>

        <p class="tpl-not-found__text">
          Попробуйте выбрать другой шаблон в каталоге.
        </p>

        <a href="/" class="btn btn--primary">
          ← Вернуться к каталогу
        </a>
      </div>
    </main>
  </div>
</section>
