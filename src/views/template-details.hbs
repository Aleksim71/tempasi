{{!-- src/views/template-details.hbs --}}

<section class="template-details">
  <header class="template-details__header">
    <h1 class="template-details__title">{{template.title}}</h1>
    <p class="template-details__subtitle">{{template.short_desc}}</p>
  </header>

  {{#if template.preview_image}}
    <div class="template-details__preview">
      <img
        src="{{template.preview_image}}"
        alt="{{template.title}}"
        class="template-details__img"
        loading="lazy"
      />
    </div>
  {{/if}}

  <div class="template-details__meta">
    {{#if template.categories}}
      <div class="template-details__categories">
        <span>Категории:</span>
        <ul>
          {{#each template.categories}}
            <li>{{name}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    {{#if template.demo_url}}
      <a
        href="{{template.demo_url}}"
        class="btn primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        Открыть демо
      </a>
    {{/if}}
  </div>

  {{#if template.full_desc}}
    <article class="template-details__body">
      <h2>Описание</h2>
      <p>{{template.full_desc}}</p>
    </article>
  {{/if}}

  {{#if template.licenses}}
    <section class="template-details__pricing">
      <h2>Лицензии и цены</h2>
      <ul class="template-details__license-list">
        {{#each template.licenses}}
          <li class="template-details__license-item">
            <strong>{{name}}</strong>
            — {{price_cents}} €
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}
</section>
