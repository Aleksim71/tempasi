<section class="template-list">
  {{#each templates}}
    <article class="template-card">
      <img src="{{img}}" alt="{{name}}" class="template-img" />

      <h3 class="template-name">{{name}}</h3>
      <p class="template-desc">{{desc}}</p>

      <div class="template-bottom">
        <span class="template-price">{{price}} €</span>
      </div>
    </article>
  {{/each}}
</section>
