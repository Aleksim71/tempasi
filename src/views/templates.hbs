<div class="page">
  <header class="page-header">
    <h1>Шаблоны</h1>
    <p>
      Выбирайте готовые дизайны для лендингов, интернет-магазинов, SaaS и других проектов.
    </p>
  </header>

  <div class="layout">
    <!-- Боковой фильтр -->
    <aside class="sidebar">
      {{> sidebar-filters}}
    </aside>

    <!-- Список шаблонов -->
    <main>
      <section class="grid">
        {{#each templates}}
          <article class="card">
            <div class="thumb">
              {{!-- сюда потом можно будет подставить превью --}}
            </div>

            <div class="card-body">
              <h2 class="card-title">{{this.name}}</h2>
              <p class="card-desc">
                {{this.description}}
              </p>
            </div>

            <div class="card-footer">
              <div>
                <div>Автор: {{this.author}}</div>
                <div class="muted">{{this.category}}</div>
              </div>
              <div>
                <div>{{this.price}} $</div>
                <a href="/templates/{{this.id}}" class="btn primary">
                  Подробнее
                </a>
              </div>
            </div>
          </article>
        {{/each}}
      </section>
    </main>
  </div>
</div>
