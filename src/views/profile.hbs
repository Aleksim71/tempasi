<main class="page">
  <div class="layout">

    <!-- ЛЕВАЯ КОЛОНКА — МЕНЮ ПРОФИЛЯ -->
    <aside class="sidebar profile-sidebar">
      <nav class="profile-nav">
        <button type="button" class="profile-nav__item is-active">Профиль</button>
        <button type="button" class="profile-nav__item">Мои избранные</button>
        <button type="button" class="profile-nav__item">Мои аренды</button>
        <button type="button" class="profile-nav__item">Billing</button>
        <button type="button" class="profile-nav__item">Сделки</button>
      </nav>
    </aside>

    <!-- ПРАВАЯ КОЛОНКА — САМИ ФОРМЫ -->
    <section class="profile-main">

      <!-- ОСНОВНЫЕ ДАННЫЕ -->
      <section class="card profile-card">
        <header class="profile-card__header">
          <h2 class="profile-card__title">Основные данные</h2>
          <div class="profile-card__actions">
            <button type="button" class="btn ghost">Отменить</button>
            <button type="submit" class="btn primary">Сохранить</button>
          </div>
        </header>

        <form class="profile-form">
          <div class="form-row">
            <label for="fullName">Полное имя</label>
            <input id="fullName" type="text" placeholder="Ваше имя" />
          </div>

          <div class="form-row">
            <label for="nickname">Никнейм</label>
            <input id="nickname" type="text" placeholder="Ваш никнейм" />
          </div>

          <div class="form-row">
            <label for="email">Email</label>
            <input id="email" type="email" placeholder="you@example.com" />
          </div>

          <div class="form-row">
            <label for="role">Роль</label>
            <input id="role" type="text" placeholder="Дизайнер, студия, агентство..." />
          </div>

          <div class="form-row">
            <label for="about">Кратко о себе</label>
            <textarea
              id="about"
              placeholder="Пара предложений о том, чем вы занимаетесь."
            ></textarea>
          </div>
        </form>
      </section>

      <!-- ПУБЛИЧНЫЙ ПРОФИЛЬ -->
      <section class="card profile-card">
        <h2 class="profile-card__title">Публичный профиль</h2>

        <form class="profile-form">
          <div class="form-row">
            <label for="portfolio">Сайт или портфолио</label>
            <input
              id="portfolio"
              type="text"
              placeholder="https://dribbble.com/username"
            />
          </div>

          <div class="form-row">
            <label for="socials">Социальные сети</label>
            <input
              id="socials"
              type="text"
              placeholder="@behance, @instagram, @twitter"
            />
          </div>

          <div class="form-row">
            <label for="bio">Биография</label>
            <textarea
              id="bio"
              placeholder="Расскажите немного о себе для страницы автора."
            ></textarea>
          </div>
        </form>
      </section>
    </section>
  </div>
</main>
