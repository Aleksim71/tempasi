{{!-- views/partials/sidebar-filters.hbs --}}
<aside class="sidebar">
  <div class="sidebar-card">
    <section class="sidebar-group">
      <h3 class="sidebar-title">Шаблоны</h3>

      <div class="sidebar-chips">
        <button type="button" class="chip chip-wide is-active">
          Лендинги
        </button>
        <button type="button" class="chip chip-wide">
          Интернет-магазины
        </button>
        <button type="button" class="chip chip-wide">
          Блог / Медиа
        </button>
        <button type="button" class="chip chip-wide">
          Портфолио
        </button>
        <button type="button" class="chip chip-wide">
          SaaS / IT
        </button>
        <button type="button" class="chip chip-wide">
          Ресторан / Кафе
        </button>
        <button type="button" class="chip chip-wide">
          Недвижимость
        </button>
        <button type="button" class="chip chip-wide">
          Образование
        </button>
        <button type="button" class="chip chip-wide">
          События
        </button>
        <button type="button" class="chip chip-wide">
          Медицина
        </button>
      </div>
    </section>

    <section class="sidebar-group">
      <h3 class="sidebar-title">Цена</h3>
      <div class="sidebar-range">
        <span class="range-min">0$</span>
        <input
          type="range"
          min="0"
          max="1000"
          value="250"
          class="range-input"
        />
        <span class="range-max">1000$</span>
      </div>
    </section>

    <section class="sidebar-group">
      <h3 class="sidebar-title">Лицензии</h3>

      <div class="sidebar-chips grid-licenses">
        <button type="button" class="chip chip-small">PU</button>
        <button type="button" class="chip chip-small">CU</button>
        <button type="button" class="chip chip-small">EL</button>
        <button type="button" class="chip chip-small">SL</button>
        <button type="button" class="chip chip-small">ML</button>
        <button type="button" class="chip chip-small">EX</button>
        <button type="button" class="chip chip-small">RF</button>
      </div>

      <button type="button" class="btn primary sidebar-apply">
        Применить фильтры
      </button>
    </section>
  </div>
</aside>
