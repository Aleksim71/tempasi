<aside class="filters">
  <div class="filters-section">
    <h3 class="filters-title">Шаблоны</h3>

    <div class="filters-group">
      <label class="filter-pill">
        <input type="checkbox" name="cat" value="landing" />
        Лендинги
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="ecommerce" />
        Интернет-магазины
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="blog" />
        Блог / Медиа
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="portfolio" />
        Портфолио
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="saas" />
        SaaS / IT
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="food" />
        Ресторан / Кафе
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="realty" />
        Недвижимость
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="education" />
        Образование
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="events" />
        События
      </label>

      <label class="filter-pill">
        <input type="checkbox" name="cat" value="medicine" />
        Медицина
      </label>
    </div>
  </div>

  <div class="filters-section">
    <h3 class="filters-title">Цена</h3>

    <div class="price-slider">
      <span>0$</span>
      <input type="range" min="0" max="1000" value="0" />
      <span>1000$</span>
    </div>
  </div>

  <div class="filters-section">
    <h3 class="filters-title">Лицензии</h3>

    <div class="filters-group">
      <label class="filter-pill"><input type="checkbox" /> PU</label>
      <label class="filter-pill"><input type="checkbox" /> CU</label>
      <label class="filter-pill"><input type="checkbox" /> EL</label>
      <label class="filter-pill"><input type="checkbox" /> SL</label>
      <label class="filter-pill"><input type="checkbox" /> ML</label>
      <label class="filter-pill"><input type="checkbox" /> EX</label>
      <label class="filter-pill"><input type="checkbox" /> RF</label>
    </div>

    <button class="btn primary filters-apply">Применить фильтры</button>
  </div>
</aside>
