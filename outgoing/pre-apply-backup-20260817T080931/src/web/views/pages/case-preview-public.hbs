{{!-- src/web/views/pages/case-preview-public.hbs --}}
<link rel="stylesheet" href="/css/pages/cabinet.css" />

<section class="cases-shell cases-shell--public-preview">
  <div class="cases-panel cases-panel--public-preview">
    {{#if workspaceData.cases.isNotFound}}
      <div class="cases-empty">
        <div class="cases-empty__title">Case preview not found</div>
        <div class="cases-empty__text">This public preview link is missing, expired, or invalid.</div>
      </div>
    {{else}}
      <div class="cases-panel__header">
        <p class="cases-panel__text">Tempasi client preview</p>
        <h1 class="cases-panel__title">{{workspaceData.cases.selectedCase.title}}</h1>
        {{#if workspaceData.cases.selectedCase.client_name}}
          <p class="cases-panel__text">Prepared for {{workspaceData.cases.selectedCase.client_name}}</p>
        {{else}}
          <p class="cases-panel__text">Selected website concepts for review.</p>
        {{/if}}
      </div>

      {{#if workspaceData.cases.templates.length}}
        <section class="case-client-carousel" data-case-client-carousel aria-label="Client template carousel">
          <div class="case-client-carousel__topbar">
            <a class="case-client-carousel__back" href="/cabinet/cases?tab=list">← List</a>
            <a class="case-client-carousel__back" href="#" data-carousel-details>Details</a>
            <a class="case-client-carousel__back" href="#" data-carousel-demo>Live Demo</a>
            <a class="case-client-carousel__back" href="#" data-carousel-buy>Buy</a>
          </div>

          <div class="case-client-carousel__viewport">
            <button class="case-client-carousel__nav case-client-carousel__nav--prev" type="button" data-carousel-prev aria-label="Previous template">‹</button>

            <div class="case-client-carousel__track">
              {{#each workspaceData.cases.templates}}
                <article class="case-client-slide {{#if @first}}is-active{{/if}}" data-carousel-slide data-details-url="{{detailsUrl}}" data-demo-url="{{liveDemoUrl}}" data-buy-url="/checkout/direct/buy/{{slug}}?caseId={{../casePreview.id}}">
                  <header class="case-client-slide__header">
                    <h2 class="case-client-slide__title">{{title}}</h2>

                    <div class="case-client-slide__prices" aria-label="Template prices">
                      {{#if buyPriceLabel}}
                        <span><strong>Buy:</strong> {{buyPriceLabel}}</span>
                      {{else}}
                        {{#if purchasePriceLabel}}
                          <span><strong>Buy:</strong> {{purchasePriceLabel}}</span>
                        {{else}}
                          <span><strong>Buy:</strong> —</span>
                        {{/if}}
                      {{/if}}

                      {{#if rentPerDayLabel}}
                        <span><strong>Rent/day:</strong> {{rentPerDayLabel}}</span>
                      {{else}}
                        {{#if rentPriceLabel}}
                          <span><strong>Rent/day:</strong> {{rentPriceLabel}}</span>
                        {{else}}
                          {{#if priceLabel}}
                            <span><strong>Rent/day:</strong> {{priceLabel}}</span>
                          {{else}}
                            <span><strong>Rent/day:</strong> —</span>
                          {{/if}}
                        {{/if}}
                      {{/if}}
                    </div>
                  </header>

                  <a class="case-client-slide__previewLink" href="{{liveDemoUrl}}" target="_blank" rel="noopener" aria-label="Open live demo for {{title}}">
                    {{#if previewUrl}}
                      <img class="case-client-slide__preview" src="{{previewUrl}}" alt="{{title}} preview" loading="lazy" />
                    {{else}}
                      <div class="case-client-slide__placeholder">{{title}}</div>
                    {{/if}}
                  </a>
                </article>
              {{/each}}
            </div>

            <button class="case-client-carousel__nav case-client-carousel__nav--next" type="button" data-carousel-next aria-label="Next template">›</button>
          </div>

          <div class="case-client-carousel__footer">
            <span data-carousel-counter>1 / {{workspaceData.cases.templates.length}}</span>
            <span class="case-client-carousel__hint">Click preview to open live demo</span>
          </div>
        </section>

        <script>
          (() => {
            const root = document.querySelector('[data-case-client-carousel]');
            if (!root) return;

            const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
            const prev = root.querySelector('[data-carousel-prev]');
            const next = root.querySelector('[data-carousel-next]');
            const counter = root.querySelector('[data-carousel-counter]');
            const detailsLink = root.querySelector('[data-carousel-details]');
            const demoLink = root.querySelector('[data-carousel-demo]');
            const buyLink = root.querySelector('[data-carousel-buy]');
            let index = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));

            function render() {
              slides.forEach((slide, i) => {
                slide.classList.toggle('is-active', i === index);
                slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
              });

              if (counter) counter.textContent = `${index + 1} / ${slides.length}`;

              const active = slides[index];
              if (active) {
                if (detailsLink) detailsLink.href = active.dataset.detailsUrl || '#';
                if (demoLink) demoLink.href = active.dataset.demoUrl || '#';
                if (buyLink) buyLink.href = active.dataset.buyUrl || '#';
              }
              if (prev) prev.disabled = slides.length <= 1;
              if (next) next.disabled = slides.length <= 1;
            }

            function go(delta) {
              if (!slides.length) return;
              index = (index + delta + slides.length) % slides.length;
              render();
            }

            prev?.addEventListener('click', () => go(-1));
            next?.addEventListener('click', () => go(1));

            document.addEventListener('keydown', (event) => {
              if (event.key === 'ArrowLeft') go(-1);
              if (event.key === 'ArrowRight') go(1);
            });

            render();
          })();
        </script>
      {{else}}
        <div class="cases-empty">
          <div class="cases-empty__title">No templates to preview yet</div>
          <div class="cases-empty__text">This case does not currently contain active rented templates.</div>
        </div>
      {{/if}}
    {{/if}}
  </div>
</section>
