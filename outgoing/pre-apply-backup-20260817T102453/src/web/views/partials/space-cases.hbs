{{!-- src/web/views/partials/space-cases.hbs --}}
<section class="cases-shell">
  <nav class="cases-tabs" aria-label="Cases sections">
    {{#each workspaceData.cases.tabs}}
      <a
        class="cases-tab {{#if isActive}}is-active{{/if}} tp-control tp-tab tp-tab--main" data-tempasi-main-tab="{{key}}"
        href="{{href}}"
        {{#if isActive}}aria-current="page"{{/if}}
      >
        {{label}}
      </a>
    {{/each}}
  </nav>

  {{!-- LIST --}}
  {{#if (eq workspaceData.cases.tab "list")}}
    <div class="cases-panel">
{{#if workspaceData.cases.items.length}}
        <div class="cases-list">
          {{#each workspaceData.cases.items}}
            <article class="cases-card">
              <div class="cases-card__main">
                <div class="cases-card__title">{{title}}</div>
                <div class="cases-card__meta">
                  <span>Templates: {{templatesCount}}</span>
                </div>
              </div>
              <div class="cases-card__actions">
                <a class="button tp-control tp-tab tp-tab--sub" href="/cabinet/cases/{{id}}">View</a>
{{#if publicPreviewUrl}}
                  <a class="button button--ghost tp-control tp-tab tp-tab--sub" href="{{publicPreviewUrl}}" target="_blank" rel="noopener">Client preview</a>
                {{/if}}
                <a class="button button--ghost tp-control tp-tab tp-tab--sub" href="/templates?caseId={{id}}">Add templates</a>
                <form method="post" action="/cabinet/cases/{{id}}/clear">
                  <button class="button button--ghost tp-action-btn tp-action-secondary tp-action-button tp-action-button--secondary tp-control tp-button tp-button--secondary" type="submit">Clear</button>
                </form>
                <form method="post" action="/cabinet/cases/{{id}}/delete">
                  <button class="button button--ghost tp-action-btn tp-action-danger tp-action-button tp-action-button--danger tp-control tp-button tp-button--danger" type="submit">Delete</button>
                </form>
                  </div>
                </div>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="cases-empty">
          <div class="cases-empty__title">No cases yet</div>
          <div class="cases-empty__text">Create your first case to start building a client shortlist.</div>
          <a class="button button--primary" href="/cabinet/cases?tab=create">Create case</a>
        </div>
      {{/if}}
    </div>
  {{/if}}


  {{!-- VIEW --}}
  {{#if (eq workspaceData.cases.tab "view")}}
    <div class="cases-panel cases-panel--internal-view" data-tempasi-view-mode="internal-case-view">
      <div class="cases-panel__header">
        <h3 class="cases-panel__title">{{workspaceData.cases.selectedCase.title}}</h3>

        <div class="cases-card__actions cases-card__actions--header">
          <a class="button tp-control tp-tab tp-tab--sub is-active" href="/cabinet/cases/{{workspaceData.cases.selectedCase.id}}" aria-current="page">View</a>

          {{#if workspaceData.cases.selectedCase.publicPreviewUrl}}
            <a class="button button--ghost tp-control tp-tab tp-tab--sub" href="{{workspaceData.cases.selectedCase.publicPreviewUrl}}" target="_blank" rel="noopener">Client preview</a>
          {{/if}}

          <a class="button button--ghost tp-control tp-tab tp-tab--sub" href="/templates?caseId={{workspaceData.cases.selectedCase.id}}">Add templates</a>

          <form method="post" action="/cabinet/cases/{{workspaceData.cases.selectedCase.id}}/clear">
            <button class="button button--ghost tp-control tp-button tp-button--secondary" type="submit">Clear</button>
          </form>

          <form method="post" action="/cabinet/cases/{{workspaceData.cases.selectedCase.id}}/delete">
            <button class="button button--ghost tp-control tp-button tp-button--danger" type="submit">Delete</button>
          </form>
        </div>
      </div>

      {{#if workspaceData.cases.templates.length}}
        <div class="cases-list">
          {{#each workspaceData.cases.templates}}
            <article class="cases-card">
              <div class="cases-card__main cases-card__main--compact">
                {{#if previewUrl}}
                  <img class="cases-template-preview" src="{{previewUrl}}" alt="{{title}} preview" loading="lazy" />
                {{/if}}

                <div class="cases-compact-content">
                  <div class="cases-compact-top">
                    <div class="cases-card__title">{{title}}</div>

                    <div class="cases-compact-prices" aria-label="Template commercial prices">
                      {{#if buyPriceLabel}}
                        <span><strong>Buy:</strong> {{buyPriceLabel}}</span>
                      {{else}}
                        {{#if purchasePriceLabel}}
                          <span><strong>Buy:</strong> {{purchasePriceLabel}}</span>
                        {{else}}
                          <span><strong>Buy:</strong> —</span>
                        {{/if}}
                      {{/if}}

                      {{#if rentPerDayLabel}}
                        <span><strong>Rent/day:</strong> {{rentPerDayLabel}}</span>
                      {{else}}
                        {{#if rentPriceLabel}}
                          <span><strong>Rent/day:</strong> {{rentPriceLabel}}</span>
                        {{else}}
                          {{#if priceLabel}}
                            <span><strong>Rent/day:</strong> {{priceLabel}}</span>
                          {{else}}
                            <span><strong>Rent/day:</strong> —</span>
                          {{/if}}
                        {{/if}}
                      {{/if}}
                    </div>
                  </div>

                  <div class="cases-card__actions cases-card__actions--compact">
                <a class="button cases-compact-action" href="{{detailsUrl}}">Details</a>
                <a class="button button--ghost cases-compact-action" href="{{liveDemoUrl}}">Live Demo</a>

                {{#if canExclude}}
                  <form method="post" action="/cabinet/cases/{{../workspaceData.cases.selectedCase.id}}/templates/{{orderId}}/exclude">
                    <button class="button button--ghost cases-compact-action" type="submit">Exclude</button>
                  </form>
                {{else}}
                  <button class="button button--ghost cases-compact-action" type="button" disabled>Exclude</button>
                {{/if}}

                {{#if availableCases.length}}
                  <form method="post" action="/cabinet/cases/{{../workspaceData.cases.selectedCase.id}}/templates/{{orderId}}/copy">
                    <select class="input" name="caseId" aria-label="Copy to case">
                      {{#each availableCases}}
                        <option value="{{id}}">{{title}}</option>
                      {{/each}}
                    </select>
                    <button class="button button--ghost cases-compact-action" type="submit">Copy to case</button>
                  </form>
                {{else}}
                  <button class="button button--ghost cases-compact-action" type="button" disabled>Copy to case</button>
                {{/if}}
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="cases-empty">
          <div class="cases-empty__title">No templates in this case yet</div>
          <div class="cases-empty__text">Add rented templates from the catalog to prepare a client presentation.</div>
          <a class="button button--primary" href="/templates?caseId={{workspaceData.cases.selectedCase.id}}">Browse templates</a>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{!-- PREVIEW --}}
  {{#if (eq workspaceData.cases.tab "preview")}}
    <div class="cases-panel">
      <div class="cases-panel__header">
        <h3 class="cases-panel__title">{{workspaceData.cases.selectedCase.title}}</h3>
        <p class="cases-panel__text">Presentation preview. Show the selected website concepts with large previews and live demos.</p>
      </div>

      {{#if workspaceData.cases.templates.length}}
        <section class="case-client-carousel" data-case-client-carousel aria-label="Client template carousel">
          <div class="case-client-carousel__topbar">
            <a class="case-client-carousel__back" href="/cabinet/cases?tab=list">← List</a>
            <a class="case-client-carousel__back" href="#" data-carousel-details>Details</a>
            <a class="case-client-carousel__back" href="#" data-carousel-demo>Live Demo</a>
            <a class="case-client-carousel__back" href="#" data-carousel-buy>Buy</a>
          </div>

          <div class="case-client-carousel__viewport">
            <button class="case-client-carousel__nav case-client-carousel__nav--prev" type="button" data-carousel-prev aria-label="Previous template">‹</button>

            <div class="case-client-carousel__track">
              {{#each workspaceData.cases.templates}}
                <article class="case-client-slide {{#if @first}}is-active{{/if}}" data-carousel-slide data-details-url="{{detailsUrl}}" data-demo-url="{{liveDemoUrl}}" data-demo-back-url="{{../workspaceData.cases.selectedCase.publicPreviewUrl}}" data-buy-url="/checkout/direct/buy/{{slug}}?caseId={{../workspaceData.cases.selectedCase.id}}">
                  <header class="case-client-slide__header">
                    <h2 class="case-client-slide__title">{{title}}</h2>

                    <div class="case-client-slide__prices" aria-label="Template prices">
                      {{#if buyPriceLabel}}
                        <span><strong>Buy:</strong> {{buyPriceLabel}}</span>
                      {{else}}
                        {{#if purchasePriceLabel}}
                          <span><strong>Buy:</strong> {{purchasePriceLabel}}</span>
                        {{else}}
                          <span><strong>Buy:</strong> —</span>
                        {{/if}}
                      {{/if}}

                      {{#if rentPerDayLabel}}
                        <span><strong>Rent/day:</strong> {{rentPerDayLabel}}</span>
                      {{else}}
                        {{#if rentPriceLabel}}
                          <span><strong>Rent/day:</strong> {{rentPriceLabel}}</span>
                        {{else}}
                          {{#if priceLabel}}
                            <span><strong>Rent/day:</strong> {{priceLabel}}</span>
                          {{else}}
                            <span><strong>Rent/day:</strong> —</span>
                          {{/if}}
                        {{/if}}
                      {{/if}}
                    </div>
                  </header>

                  <a class="case-client-slide__previewLink" href="{{liveDemoUrl}}" data-slide-demo-link aria-label="Open live demo for {{title}}">
                    {{#if previewUrl}}
                      <img class="case-client-slide__preview" src="{{previewUrl}}" alt="{{title}} preview" loading="lazy" />
                    {{else}}
                      <div class="case-client-slide__placeholder">{{title}}</div>
                    {{/if}}
                  </a>
                </article>
              {{/each}}
            </div>

            <button class="case-client-carousel__nav case-client-carousel__nav--next" type="button" data-carousel-next aria-label="Next template">›</button>
          </div>

          <div class="case-client-carousel__footer">
            <span data-carousel-counter>1 / {{workspaceData.cases.templates.length}}</span>
            <span class="case-client-carousel__hint">Click preview to open live demo</span>
          </div>
        </section>

        <script>
          (() => {
            const root = document.querySelector('[data-case-client-carousel]');
            if (!root) return;

            const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
            const prev = root.querySelector('[data-carousel-prev]');
            const next = root.querySelector('[data-carousel-next]');
            const counter = root.querySelector('[data-carousel-counter]');
            const detailsLink = root.querySelector('[data-carousel-details]');
            const demoLink = root.querySelector('[data-carousel-demo]');
            const buyLink = root.querySelector('[data-carousel-buy]');
            let index = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));

            function withBack(url, backUrl) {
              if (!url) return '#';
              if (!backUrl) return url;
              const separator = url.includes('?') ? '&' : '?';
              return `${url}${separator}back=${encodeURIComponent(backUrl)}`;
            }

            function render() {
              slides.forEach((slide, i) => {
                slide.classList.toggle('is-active', i === index);
                slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');

                const slideDemoLink = slide.querySelector('[data-slide-demo-link]');
                if (slideDemoLink) {
                  slideDemoLink.href = withBack(slide.dataset.demoUrl, slide.dataset.demoBackUrl);
                }
              });

              const activeSlide = slides[index];

              if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
              if (detailsLink) detailsLink.href = activeSlide?.dataset.detailsUrl || '#';
              if (demoLink) demoLink.href = withBack(activeSlide?.dataset.demoUrl, activeSlide?.dataset.demoBackUrl);
              if (buyLink) buyLink.href = activeSlide?.dataset.buyUrl || '#';

              if (prev) prev.disabled = slides.length <= 1;
              if (next) next.disabled = slides.length <= 1;
            }

            function go(delta) {
              if (!slides.length) return;
              index = (index + delta + slides.length) % slides.length;
              render();
            }

            prev?.addEventListener('click', () => go(-1));
            next?.addEventListener('click', () => go(1));

            document.addEventListener('keydown', (event) => {
              if (event.key === 'ArrowLeft') go(-1);
              if (event.key === 'ArrowRight') go(1);
            });

            render();
          })();
        </script>
      {{else}}
        <div class="cases-empty">
          <div class="cases-empty__title">No templates to preview yet</div>
          <div class="cases-empty__text">Add templates to this case before opening the presentation preview.</div>
        </div>
      {{/if}}
    </div>
  {{/if}}


  {{!-- CREATE --}}
  {{#if (eq workspaceData.cases.tab "create")}}
    <div class="cases-panel">
      <div class="cases-panel__header">
        <h3 class="cases-panel__title">Create Case</h3>
        <p class="cases-panel__text">Create an empty client space and fill it later.</p>
      </div>

      <form class="form cases-create-form" method="post" action="/cabinet/cases">
        <div class="form__row">
          <label class="form__label" for="caseTitle">Case name</label>
          <input class="input" id="caseTitle" name="title" type="text" placeholder="Client Alpha" />
        </div>

        <div class="actions">
          <button class="button button--primary" type="submit">Create case</button>
          <a class="button" href="/cabinet/cases?tab=list">Back to list</a>
        </div>
      </form>
    </div>
  {{/if}}

  {{!-- RENTS --}}
  {{#if (eq workspaceData.cases.tab "rents")}}
    <div class="cases-panel">
      <div class="cases-panel__header">
        <h3 class="cases-panel__title">Active Rent Reservations</h3>
        <p class="cases-panel__text">
          Templates currently reserved by active RENT holds. While active, these templates are hidden from the public catalog and can be bought only by the current renter.
        </p>
      </div>

      {{#if workspaceData.cases.rents.length}}
        <div class="cases-rents">
          {{#each workspaceData.cases.rents}}
            <article class="cases-rent-card">
              <div class="cases-rent-card__title">{{title}}</div>

              <div class="cases-rent-card__meta">
                <span>Status: {{reservationLabel}}</span>
                <span>Hold type: {{sourceLabel}}</span>
                <span>Reserved until: {{expiresAtLabel}}</span>
                <span>Time left: {{timeLeftLabel}}</span>
                <span>Rent cost: €{{dailyRentPriceEur}} / 24h</span>
                <span>Cases: {{casesCount}}</span>
              </div>

              <p class="cases-panel__text">{{reservationText}}</p>
              <p class="cases-panel__text">
                One template = one BUY. Cases are only presentation placements.
                You can show this rented template in multiple cases. This does not create multiple purchases.
                If you buy it later, you buy the template only once.
              </p>

              <div class="cases-rent-card__assignments">
                <strong>Assigned cases</strong>

                {{#if assignedCases.length}}
                  <div class="cases-list">
                    {{#each assignedCases}}
                      <form class="cases-card" method="post" action="/cabinet/cases/rents/{{../orderId}}/remove-case">
                        <input type="hidden" name="caseId" value="{{id}}" />
                        <div class="cases-card__main">
                          <div class="cases-card__title">{{title}}</div>
                          <div class="cases-card__meta">
                            <span>Presentation placement</span>
                          </div>
                        </div>
                        <div class="cases-card__actions">
                          <button class="button button--ghost" type="submit">Remove</button>
                        </div>
                      </form>
                    {{/each}}
                  </div>

                  {{#unless canRemoveAssignments}}
                    <p class="cases-panel__text">{{lastAssignmentMessage}}</p>
                  {{/unless}}
                {{else}}
                  <p class="cases-panel__text">No Case assignments found for this active rent.</p>
                {{/if}}
              </div>

              {{#if availableCases.length}}
                <form class="form cases-create-form" method="post" action="/cabinet/cases/rents/{{orderId}}/assign">
                  <div class="form__row">
                    <label class="form__label" for="caseAssign{{orderId}}">Add to another Case</label>
                    <select class="input" id="caseAssign{{orderId}}" name="caseId">
                      {{#each availableCases}}
                        <option value="{{id}}">{{title}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="cases-rent-card__actions">
                    <button class="button" type="submit">Add to case</button>
                    <button class="button button--ghost" type="button">Buy exclusive</button>
                  </div>
                </form>
              {{else}}
                <div class="cases-rent-card__actions">
                  <button class="button button--ghost" type="button">Buy exclusive</button>
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="cases-empty">
          <div class="cases-empty__title">No active rent reservations</div>
          <div class="cases-empty__text">
            After a user rents a template, the active reservation will appear here and the template will be unavailable in the public catalog.
          </div>
          <a class="button button--primary" href="/templates">Browse catalog</a>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{!-- ANALYTICS --}}
  {{#if (eq workspaceData.cases.tab "analytics")}}
    <div class="cases-panel">
      <div class="cases-panel__header">
        <h3 class="cases-panel__title">Analytics</h3>
        <p class="cases-panel__text">Current state and later time-based case/rent analytics.</p>
      </div>

      <div class="cases-kpis">
        <div class="cases-kpi">
          <div class="cases-kpi__label">Active cases</div>
          <div class="cases-kpi__value">{{workspaceData.cases.analytics.activeCases}}</div>
        </div>
        <div class="cases-kpi">
          <div class="cases-kpi__label">Held templates</div>
          <div class="cases-kpi__value">{{workspaceData.cases.analytics.heldTemplates}}</div>
        </div>
        <div class="cases-kpi">
          <div class="cases-kpi__label">Active rent cost</div>
          <div class="cases-kpi__value">€{{workspaceData.cases.analytics.activeRentCostEur}}</div>
        </div>
      </div>

      <div class="cases-placeholder">
        Deeper analytics for periods, case efficiency, and rent dynamics will be added in the next pass.
      </div>
    </div>
  {{/if}}
</section>
