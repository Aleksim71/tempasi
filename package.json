{
  "type": "module",
  "name": "tempasi",
  "version": "1.0.0",
  "description": "Tempasi MVP backend + static frontend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:templates-demo": "node src/templates-demo.server.js",
    "dev:templates-demo": "nodemon src/templates-demo.server.js",
    "ingest-template": "node ingest-template.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "dev:buy": "bash scripts/dev-buy.sh",
    "test": "node -e \"if(!process.env.DATABASE_URL_TEST){console.error('Set DATABASE_URL_TEST');process.exit(1)}\" && NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.cjs",
    "test:db:check": "node scripts/db-test-preflight.cjs",
    "test:db": "npm run test:db:check && npm test",
    "test:db:local": "DATABASE_URL_TEST=postgres://tempasi:tempasi@127.0.0.1:5433/tempasi_test npm test"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.37.0",
    "eslint-config-metarhia": "^9.1.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "nodemon": "^3.1.11",
    "pg": "^8.16.3",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.34.0",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.4",
    "hbs": "^4.2.0",
    "http-proxy-middleware": "^3.0.5",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  }
}
